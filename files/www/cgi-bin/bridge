    "mem_total": "$(jesc "${M_TOTAL_H} MB")",
    "mem_avail": "$(jesc "${M_AVAIL_H} MB")",
    "mem_used": "$(jesc "${M_USED_H} MB")",
    "swap_total_kb": $SW_TOTAL,
    "swap_used_kb": $SW_USED,
    "temp_c": $TEMP_C,
    "temp_has": $TEMP_HAS,
