# 【第 34 次】SSH 服务配置（WDS / AP 两套固件共用）
#
# ★ 为什么删掉 `option Interface 'lan'` —— 拉 OpenWrt 21.02 dropbear.init 原文实证：
#     dropbear_instance(){
#       [ -n "${Interface}" ] && {
#           [ -n "${BOOT}" ] && return 0                                # 开机直接不建实例
#           network_get_ipaddrs_all ipaddrs "${Interface}" || return 1   # lan 没起来也不建
#       }
#       ... append_ports "${ipaddrs}" "${Port}"
#     }
#     append_ports(){ [ -z "$ipaddrs" ] && { procd_append_param command -p "$port"; return; } ... }
#   仓库原来写了 Interface='lan'，于是：
#     · 开机 BOOT=1 → return 0，实例不建，只能等 netifd hotplug 补；
#     · bridge-role 主备收敛会把 172.10.10.241 改成 172.10.10.242，已绑旧 IP / 没触发 reload → 22 连不上。
#   删掉后 ipaddrs 为空 → `-p 22` 监听 0.0.0.0:22，不依赖 lan 就绪、不受 IP 切换影响。
#
# ★ 为什么删掉 4 个 *keyfile：21.02 的 uci_load_validate schema 只声明
#   `rsakeyfile:file` 与 `keyfile:list(file)`；dss/ecdsa/ed25519keyfile 不在 schema，
#   部分 21.02 小版本会直接 "validation failed"。让 dropbear 自己按默认路径建密钥即可。
#   保留的键全部在 schema 内（PasswordAuth/enable/GatewayPorts/RootPasswordAuth/
#   RootLogin/Port/SSHKeepAlive/IdleTimeout/MaxAuthTries）。
#
# 密码：首启 99-bridge-ready 写入的 hash 已用 openssl 实算校验 = `admin`。
# 连接目标：WDS 主 172.10.10.241 / 备 172.10.10.242（别连错）。

config dropbear 'main'
	option enable '1'
	option PasswordAuth '1'
	option RootPasswordAuth '1'
	option RootLogin '1'
	option Port '22'
	option GatewayPorts '0'
	option SSHKeepAlive '300'
	option IdleTimeout '0'
	option MaxAuthTries '6'
