# WDS 无线看门狗（机器狗）默认配置 —— 第 49 次：恢复启用 + 全参数可自定义
# ★ 用户要求：网桥要机器狗，连续不通 5 分钟自动重启，时间可自己改。
# ★ 第 45 次曾因「单机/无对端刷机后约 11 分钟反复重启」改成默认停用；
#   第 49 次不是简单改回 enabled=1，而是同时补三条防误伤机制：
#     1) mode=or：无线关联 / ping 对端 / ping 锚点，任一通就算通（不误重启）
#     2) peer=auto：按主备角色自动推导【对端】IP（.241 ↔ .242），不 ping 自己
#     3) max_reboots=3：连续重启 3 次仍不通 → 自动转 dryrun=1 停手，不再无限循环
#   开机宽限 grace=6 分钟内不判故障，这段时间足够 SSH 进去改配置 / dryrun on。
# ★ AP 模式由 files.ap/etc/config/wdsdog 覆盖为 enabled=0，刷 AP 固件不会重启。

config wdsdog 'main'
	option enabled '1'       # 1=WDS 网桥默认启用；0=彻底停用（off）
	option delay '5'         # ★连续不通多少分钟才重启（0~120）；set-delay 10 即改 10 分钟
	option grace '6'         # 开机宽限：等 ath11k 校准 + bridge-role 收敛
	option interval '30'     # 每多少秒检查一次
	option iface 'auto'      # 只盯 WDS 那个 5G 接口
	option peer 'auto'       # auto=自动推导对端；也可填具体 IP；off=不 ping
	option anchor ''         # 可选锚点（如 172.10.10.254 / 上级网关），任一通即算通
	option mode 'or'         # or | ping | wireless；or 最不容易误重启
	option max_reboots '3'   # 连续重启上限，达到后自动转 dryrun 停手
	option dryrun '0'        # 0=真重启；1=只记日志不重启（调试用）

# 现场改（全部立即生效、UCI 持久化、不用重编）：
