# WDS 无线看门狗（机器狗）默认配置 · 第 53 次：按用户要求恢复启用
#
# ★ 机器狗从来没被删除：脚本、procd 服务、判据、防误重启保护一直都在。
#   第 49 次只是把【出厂开关】关掉（enabled=0 / dryrun=1），因为当时 VS010
#   单机刷完被判「链路断了」循环 reboot -f。第 53 次恢复启用，但保留那条
#   关键保护：★「从未成功关联过」绝不重启 ★ —— 单机 / 未配对 / 无线没起来
#   只记日志，不会重启。只有【配对成功后链路连续不通】才按 delay 重启。
#
#   enabled=1 / delay=5 / dryrun=0 → 连续不通 5 分钟自动重启（你要的默认值）
#   ★ 自定义：bridge-watchdog set-delay N     （0~120 分钟，立即生效，不用重编）
#              bridge-watchdog set-interval N  （检查间隔秒，默认 30）
#              bridge-watchdog set-grace N     （开机宽限分钟，默认 6）
#              bridge-watchdog set-peer IP     （手工指定对端管理 IP）
#              bridge-watchdog set-peer auto   （自动发现，推荐）
#              bridge-watchdog off             （刷机 / TTL 调试前先关）
#              bridge-watchdog dryrun on       （只记日志不重启，观察一两天）
#              bridge-watchdog status          （看当前延时 / 判据 / 还剩多久）
#
# ★ 判据：peer=auto 时从 5G WDS 链路对端的 MAC 反查邻居表拿真实 IP，
#   自动排除本机地址（第 52 次所有设备统一 172.10.10.241，ping 自己会永远通）；
#   解析不到就退回「无线关联」判据，绝不因为查不到对端就判成不通而重启。
# ★ 改管理 IP 时：循环会检测到 IP 变化 → 重置连续计时 + 重新发现对端，
#   不重启；改 IP 的工具也会提示同步 set-peer（见下载页红色说明）。
#
# 改完不用重编：uci commit wdsdog && /etc/init.d/bridge-watchdog restart
config wdsdog 'main'
	option enabled '1'       # ★ 第 53 次恢复启用（第 49 次曾为 0）
	option delay '5'         # ★ 连续不通 5 分钟重启；set-delay N 自定义 0~120
	option grace '6'         # 开机宽限 6 分钟：等无线校准 + 角色收敛
	option interval '30'     # 每 30 秒检查一次；set-interval N 自定义
	option iface 'auto'      # 只盯 WDS 那个 5G 接口
	option peer 'auto'       # ★ 自动发现对端 IP；也可填具体 IP / 留空用无线关联
	option dryrun '0'        # ★ 真重启（观察期可 dryrun on）
