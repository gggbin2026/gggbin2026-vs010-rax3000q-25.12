# 无线端 DHCP 防护（二层 rogue-DHCP 拦截）
# 目标：无线客户端/对端若私开 DHCP 服务器，其 Offer/ACK 不得污染 br-lan；
#       有线侧上级路由的 DHCP 照常透传，AP 模式客户端仍从上级拿地址。
# 实现：独立 nft bridge 表，只丢「从无线口进入、源端口 67 → 目的端口 68」的报文。
#       不装 firewall4、不加载任何 filter/NAT 规则，和「关闭防火墙」不冲突。
# ⚠ NSS wifi_offload 时部分射频报文不经过 host bridge hook，此为尽力防护；
#   真正的端口级 DHCP Snooping 需交换芯片/NSS 支持，见 docs/DHCP与SSH防护.md。

config l2guard 'main'
	option enabled '1'
	# 无线侧的 netdev 名字：25.12 wifi-scripts 常见 phy0-ap0 / phy1-ap0，
	# 老式 wlan0 / wlan1 一并匹配；WDS 4addr 接口也在内。
	option wlan_pattern 'wlan* phy*-ap*'
	# 同时拦 DHCPv6 Advertise/Reply（udp 547→546），防止 IPv6 侧被抢
	option dhcpv6 '1'
	# 只打印不拦（调试用；1=只记日志不下 drop 规则）
	option dryrun '0'
