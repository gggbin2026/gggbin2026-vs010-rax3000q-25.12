# QSDK 5.4 / OpenWrt 21.02 编译期无线配置（双仓通用）
# ⚠ OpenWrt 25.12 用 option band（2g/5g）；21.02 的 hwmode 已升级。
# ⚠ 不写 option path，让 wifi 脚本按 phy0/phy1 顺序绑定。
# 2.4G = 常驻调试 AP（不参与 WDS），无论被分成 ap 还是 sta 都能连上管理页；
# 5G  = WDS 链路，开机由 bridge-role 自动收敛成「一主(ap) 一备(sta)」。
# ★ HE160 必须用 ch36（36~64 共 160MHz 连续频谱）；原 ch149 段只有
#   149/153/157/161/165 五个 20MHz 块 = 100MHz，做不出 160MHz 频宽。
#   若 BDF / ath11k 固件不支持 160MHz，驱动会自动回落到 HE80，不影响开机。
# 全部 disabled=0：旧版只设 radio 的 disabled，wifi-iface 默认还是 1 → 不发 SSID。

config wifi-device 'radio0'
	option type 'mac80211'
	option band '2g'
	option channel '1'
	option htmode 'HE40'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'BRIDGE-SETUP'
	option encryption 'psk2+ccmp'
	option key 'admin12345'
	option disabled '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option band '5g'
	option channel '36'
	option htmode 'HE160'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'WDS_AP'
	option encryption 'psk2+ccmp'
	option key 'WDS123456'
	option wds '1'
	option disabled '0'
