# QSDK 5.4 / OpenWrt 21.02 —— 编译期 uhttpd 配置（双机型通用）
# 【为什么必须打包】实机现象：/bridge/ 静态页能开，但 /cgi-bin/bridge 两条路径
# 都读取失败（页面黄条 "CGI 未返回数据"）。uhttpd 包自带 /etc/config/uhttpd 是
# conffile；首启配置目录不完整、旧 overlay、或 uci-defaults 里一句
#   uci set uhttpd.main.cgi_prefix='/cgi-bin'
# 落在不存在的 main 段上，UCI extended lookup 会造出【匿名 config uhttpd】
# 而不是 config uhttpd 'main' —— uhttpd init 找不到 named main，cgi_prefix
# 回落为空 → 静态文件照常服务，CGI 404/403，LuCI 也可能一起挂。
# 和上一轮 LuCI dispatcher.lua:427 是同一个 UCI 坑，这次是 uhttpd 版。
# 编译期写死 named section，运行期只做校验、不再有机会造畸形段。
# 注意：本机 IPv6 编译期关闭，因此只监听 0.0.0.0，不写 [::]:80。

config uhttpd 'main'
	list listen_http '0.0.0.0:80'
	option redirect_https '0'
	option home '/www'
	option rfc1918_filter '1'
	option max_requests '3'
	option max_connections '100'
	option cgi_prefix '/cgi-bin'
	list lua_prefix '/cgi-bin/luci=/usr/lib/lua/luci/sgi/uhttpd.lua'
	option script_timeout '60'
	option network_timeout '30'
	option http_keepalive '20'
	option tcp_keepalive '1'
	option ubus_prefix '/ubus'

config cert 'defaults'
	option days '730'
	option key_type 'ec'
	option ec_curve 'P-256'
	option country 'ZZ'
	option state 'Somewhere'
	option location 'Unknown'
	option commonname 'ImmortalWrt'
