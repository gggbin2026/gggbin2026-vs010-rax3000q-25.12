# QSDK 5.4 / LuCI 21.02 —— 编译期 LuCI 配置（双仓通用）
# 【为什么必须打包】luci-base 自带 /etc/config/luci 是 conffile；若首启时该文件
# 缺失/被清空（firstboot、旧 overlay、preinit 分叉都会），99-bridge-ready 里的
#   uci -q set luci.main.mediaurlbase=...
# 会触发 UCI 的 extended lookup：自动创建一个【匿名、type=main】的 config main 段，
# 而不是 config core 'main'（named section）。LuCI 的 dispatcher.lua:427 按名字找
# 'main' 找不到 → 报 "seems to be corrupt, unable to find section 'main'"，WEB 打不开。
# 编译期写死，uci-defaults 只是改值，不再有机会造出畸形段。

config core 'main'
	option lang 'zh_cn'
	option mediaurlbase '/luci-static/argon'
	option resourcebase '/luci-static/resources'

config internal 'sauth'
	option sessionpath '/var/run/luci'
	option sessiontime '3600'

config internal 'themes'
	option Argon '/luci-static/argon'
	option Bootstrap '/luci-static/bootstrap'
