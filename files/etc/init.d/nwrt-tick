#!/bin/sh /etc/rc.common
# START=25：唯一常驻进程。procd respawn 保证挂了自动拉起（轻量机器狗）。
START=25
USE_PROCD=1
start_service() {
  v=$(grep -m1 '^ENABLED=' /etc/nwrt/tick.conf 2>/dev/null | cut -d= -f2)
  [ "$v" = 1 ] || { logger -t nwrt-tick 'ENABLED!=1，出厂不启动'; return 0; }
  procd_open_instance
  procd_set_param command /usr/sbin/nwrt-tick
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
