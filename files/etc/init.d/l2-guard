#!/bin/sh /etc/rc.common
# START=22：独立 nft bridge 表，只丢无线侧进来的 DHCP Offer/ACK
# 🔴 hook 必须是 prerouting：私设 DHCP 发给「别的客户端」的帧走桥转发，
#    hook input 只抓目的地址是本机的那份，根本拦不住。prerouting 抓所有进桥的帧。
# ⚠ NSS 卸载后部分报文不过 host bridge hook，属尽力防护（如实写在状态里，不假装硬保证）。
START=22
STATUS=/tmp/nwrt-l2guard.status
start() {
  if [ "$(uci -q get l2guard.main.enabled 2>/dev/null)" != 1 ]; then
    echo '未启用（l2guard.main.enabled≠1）' > "$STATUS"
    logger -t l2-guard "disabled"
    return 0
  fi
  if ! command -v nft >/dev/null 2>&1; then
    echo '失败：镜像里没有 nft（nftables 未编入）' > "$STATUS"
    logger -t l2-guard "FAILED 无 nft 命令，无线侧 DHCP 未被拦"
    return 1
  fi
  # 先删旧表再建，保证重复执行 / health-fix 重跑不会叠规则
  nft delete table bridge nwrt_l2guard 2>/dev/null || true
  if nft -f - <<'NFT'
table bridge nwrt_l2guard {
  chain prerouting {
    type filter hook prerouting priority -200; policy accept;
    iifname { "wlan*", "phy*-ap*" } udp sport 67  udp dport 68  drop
    iifname { "wlan*", "phy*-ap*" } udp sport 547 udp dport 546 drop
  }
}
NFT
  then
    # 回读确认规则真在表里，不只是 nft 返回 0
    if nft list table bridge nwrt_l2guard 2>/dev/null | grep -q 'udp sport 67'; then
      echo '已生效：拦截无线侧 DHCPv4/v6 Offer/ACK（hook prerouting）' > "$STATUS"
      logger -t l2-guard "OK 无线侧 DHCP 已拦（prerouting）"
      return 0
    fi
    echo '失败：规则未落表（内核缺 kmod-nft-bridge？）' > "$STATUS"
    logger -t l2-guard "FAILED 规则未落表"
    return 1
  fi
  echo '失败：nft -f 被拒（table bridge 不可用）' > "$STATUS"
  logger -t l2-guard "FAILED nft -f 被拒，无线侧 DHCP 未被拦"
  return 1
}
stop(){
  nft delete table bridge nwrt_l2guard 2>/dev/null || true
  echo '已停止' > "$STATUS"
}
status(){
  cat "$STATUS" 2>/dev/null || echo '未运行'
}
EXTRA_COMMANDS="status"
