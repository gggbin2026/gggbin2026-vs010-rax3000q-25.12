#!/bin/sh /etc/rc.common
# l2-guard —— 无线端 rogue DHCP 拦截（独立 nft bridge 表，不碰 firewall4）
# START=22：晚于 bridge-netfix(21)、早于 wifi-fullspeed(24) / network。
# 缺 nft / 缺内核 bridge 表支持时静默跳过，绝不停机（最稳）。
USE_PROCD=0
START=22
STOP=90
CONF=/etc/config/l2guard

start() {
    [ -x /usr/sbin/l2-guard ] || return 0
    /usr/sbin/l2-guard apply
}
stop() {
    [ -x /usr/sbin/l2-guard ] || return 0
    /usr/sbin/l2-guard off
}
restart() { stop; start; }
