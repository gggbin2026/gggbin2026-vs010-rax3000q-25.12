#!/bin/sh /etc/rc.common
# ntp-poller —— 固定周期 NTP 客户端（第 51 次）· procd 服务
# 出厂每 5 分钟循环校时一次：开机立即同步 → sleep 300 → 再同步 → 无限循环。
# 与 sysntpd 二选一：本服务启用时 sysntpd 常驻必须停（两个进程同时改时间会打架）。
# 切换由 99-bridge-ready（首启）+ rc.local / health-fix（每次开机）保证，
# 且都带兜底：本脚本没编进固件时不碰 sysntpd，避免彻底没 NTP。
USE_PROCD=1
START=96
STOP=10
PROG=/usr/sbin/ntp-poller

start_service() {
    [ "$(uci -q get system.ntp.enabled 2>/dev/null)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command "$PROG" loop
    # 脚本意外退出也让 procd 拉回来（5 秒后重试，最多 5 次/小时）
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "system"
}

reload_service() {
    restart
}
