#!/bin/sh /etc/rc.common
# 第 50 次：无线 DHCP Snooping 开机自启（WDS / AP 两条线共用）
#
# 为什么需要：以前只有 WDS 的 rc.local 在后台调一次 dhcp-guard，
# 而 files.ap/ 没有 rc.local → AP 固件刷完防护根本没起来。
# 这里用标准 rc.d 每次开机跑一次；dhcp-guard 是 oneshot（非常驻进程），
# 规则幂等，rc.local 里那次重复调用无害，形成双保险。
START=96
STOP=10

start() {
    [ -x /usr/sbin/dhcp-guard ] || return 0
    # ebtables 规则用 wlan+ / ath+ 通配，无线口尚未注册也能下规则
    /usr/sbin/dhcp-guard >/dev/null 2>&1 || true
}
