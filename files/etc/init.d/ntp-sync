#!/bin/sh /etc/rc.common
# 第 53 次 · NTP 定时同步（默认每 300 秒 / 5 分钟）· procd 服务
USE_PROCD=1
START=98
STOP=10
start_service() {
    [ "$(uci -q get ntp-sync.main.enabled 2>/dev/null)" = "1" ] || return 0
    [ -x /usr/sbin/ntp-sync ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/ntp-sync loop
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger "ntp-sync"; }
reload_service()   { restart; }
