#!/bin/sh /etc/rc.common
# WDS 无线看门狗（机器狗）· procd 服务
# 由 99-bridge-ready 在首次开机 enable+start；也可用 bridge-watchdog on/off 控制。
USE_PROCD=1
START=95
STOP=10

start_service() {
    # enabled=0 时连实例都不起，off 是彻底停用
    [ "$(uci -q get wdsdog.main.enabled 2>/dev/null)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/bridge-watchdog loop
    # 脚本意外退出也让 procd 拉回来，别让看门狗自己先死
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "wdsdog"
}

reload_service() {
    restart
}
