#!/bin/sh /etc/rc.common
# LuCI /etc/config/luci 早期自修（START=18，早于 uhttpd 的 50）
# 同时由 /usr/sbin/luci-fix 按实际目录重写主题下拉，杜绝「选到不存在的主题 → 500」
#
# 为什么需要它：dispatcher.lua:427 "unable to find section 'main'" 只在
# /etc/config/luci 缺【named section core 'main'】时报。编译期 files/etc/config/luci
# 是对的，但 sysupgrade 勾「保留配置」/ 旧 overlay 残留会用坏文件盖掉它。
# 第 22 次把重建挂到 bridge-netfix(START=21)，可 bridge-netfix 自己若没被
# enable（正是实机那串服务链没跑完的毛病），LuCI 就一直坏着 —— 实机复现。
# 本脚本更早、不依赖 bridge-netfix、不依赖 uci-defaults（首启跑一次就自删），
# 每次冷启无条件调 /usr/sbin/luci-fix，且脚本缺失时就地补建，绝不空手放行。
USE_PROCD=0
START=18
STOP=10

start() {
    if [ -x /usr/sbin/luci-fix ]; then
        /usr/sbin/luci-fix >/dev/null 2>&1 || true
    else
        grep -qE "^[[:space:]]*config[[:space:]]+core[[:space:]]+'main'" /etc/config/luci 2>/dev/null || {
            mkdir -p /etc/config 2>/dev/null || true
            cat > /etc/config/luci <<'EOF'
config core 'main'
	option lang 'zh_cn'
	option mediaurlbase '/luci-static/bootstrap'
	option resourcebase '/luci-static/resources'

config internal 'sauth'
	option sessionpath '/var/run/luci'
	option sessiontime '3600'

config internal 'themes'
	option Bootstrap '/luci-static/bootstrap'
EOF
            chmod 644 /etc/config/luci 2>/dev/null || true
        }
    fi
    rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null || true
}
