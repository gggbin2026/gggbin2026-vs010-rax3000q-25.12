#!/bin/sh
# wifi-bdf-check —— 无线板级数据 / 校准自检（第 21 次校准）
#
# 用途：VS010 之前没装专用 BDF，只能用固件自带的通用 board-2.bin，
# 5G FEM（KCT8539S）与 2.4G 内置 FEM 的功率表对不上，表现「能连但弱」。
# 本脚本把「固件到底加载了哪份板级数据、校准有没有生效」一次性打印出来，
# 刷完 / 对比原厂固件时跑一次即可，不需要抓 dmesg 全文。
#
# 两套固件（WDS 网桥 / 普通 AP）共用，只读不改任何配置。
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH

BOARD=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo 'unknown')
MODEL=$(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null | tr -d '\0')
[ -z "$MODEL" ] && MODEL='IPQ50xx'
MODE=$(cat /etc/firmware_mode 2>/dev/null || echo 'unknown')

# 已知 VS010 原厂 BDF 的 MD5（来自 xiangye277/vs010-openwrt/oem_extract）
MD5_VS010_2G='c7d89771464322ea39ca290249295af9'
MD5_VS010_5G='0aadbd42dc960aefdffe09177dd275b9'

hr() { echo '------------------------------------------------------------'; }
md5of() { [ -r "$1" ] && md5sum "$1" 2>/dev/null | awk '{print $1}' || echo '缺失'; }

echo '============================================================'
echo ' 无线板级数据 / 校准自检  ·  wifi-bdf-check'
hr
printf ' 机型        : %s\n' "$MODEL"
printf ' board_name  : %s\n' "$BOARD"
printf ' 固件模式    : %s\n' "$MODE"
hr

# ── 1. 驱动栈与 BDF 位置 ─────────────────────────────────────────
echo ' [1] 驱动栈 / BDF 位置（dmesg 关键行）'
dmesg 2>/dev/null | grep -iE 'cnss|ath11k|BDF location|bdwlan|calibration|caldata' \
  | tail -n 18 | sed 's/^/     /' || true
echo '     说明：出现 cnss / BDF location = QSDK 从 DDR 读 BDF；'
echo '           出现 ath11k / board-2.bin = 走 rootfs 板级包（本固件的修复落点）。'
hr

# ── 2. 实际落盘的 board-2.bin ────────────────────────────────────
echo ' [2] rootfs 里的板级数据（board-2.bin）'
for p in \
  /lib/firmware/ath11k/IPQ5018/hw1.0/board-2.bin \
  /lib/firmware/ath11k/qcn6122/hw1.0/board-2.bin \
  /lib/firmware/ath11k/QCN6122/hw1.0/board-2.bin \
  /lib/firmware/IPQ5018/hw1.0/board-2.bin \
  /lib/firmware/qcn6122/hw1.0/board-2.bin ; do
  [ -e "$p" ] || continue
  m=$(md5of "$p")
  sz=$(wc -c < "$p" 2>/dev/null || echo 0)
  printf '     %s\n        size=%s  md5=%s\n' "$p" "$sz" "$m"
done
B2G=$(md5of /lib/firmware/ath11k/IPQ5018/hw1.0/board-2.bin)
B5G=$(md5of /lib/firmware/ath11k/qcn6122/hw1.0/board-2.bin)
# 第 39 次：上游 ipq-wifi 用大写 QCN6122 目录，小写缺失时回退大写
[ "$B5G" = '缺失' ] && B5G=$(md5of /lib/firmware/ath11k/QCN6122/hw1.0/board-2.bin)
case "$BOARD" in
  *vs010*)
    ok=1
    [ "$B2G" = "$MD5_VS010_2G" ] || ok=0
    [ "$B5G" = "$MD5_VS010_5G" ] || ok=0
    if [ "$ok" = 1 ]; then
      echo '     ✅ 两份都是 VS010 原厂 BDF（本地落盘已生效；大小写双目录已覆盖）'
    else
      echo '     ⚠ 与 VS010 原厂 BDF 的 MD5 不一致：'
      echo "       期望 2.4G $MD5_VS010_2G"
      echo "       期望 5G   $MD5_VS010_5G"
      echo '       → 若 [1] 显示 QSDK cnss2 从 DDR 读 BDF，则这里不参与，属预期；'
      echo '         需把仓库 vs010/bdf/ 的两个 128KB 文件写进 wifi_fw 分区。'
      echo '       → 若 [1] 显示 ath11k 走 rootfs，则说明包没装上，检查 .config。'
    fi
    ;;
  *rax3000q*|*)
    echo '     本机应使用 ipq-wifi-cmcc_rax3000q（RAX3000Q 专用 BDF）；'
    echo '     不应出现 ipq-wifi-cucc_vs010（两个包都写同一路径，互斥）。'
    ;;
esac
hr

# ── 3. ART 校准产物 ──────────────────────────────────────────────
echo ' [3] ART 校准产物（hotplug caldata）'
for p in \
  /lib/firmware/ath11k/IPQ5018/hw1.0/caldata.bin \
  /lib/firmware/ath11k/qcn6122/hw1.0/caldata_1.bin ; do
  if [ -e "$p" ]; then
    printf '     %s  size=%s  md5=%s\n' "$p" "$(wc -c < "$p")" "$(md5of "$p")"
  else
    printf '     %s  缺失（QSDK cnss2 自取 ART 时属正常）\n' "$p"
  fi
done
INVALID=$(dmesg 2>/dev/null | grep -icE 'calibration data invalid|caldata.*invalid|calibration.*fallback' || true)
printf '     dmesg 校准无效/回退行数: %s\n' "$INVALID"
[ "${INVALID:-0}" -gt 0 ] && {
  echo '     ⚠ 校准窗口偏移可能不适合本机 —— 用本机 0:ART 实测，'
  echo '       改 diy-part2.vs010.sh 第 4 节里 cucc,vs010 分支的两个偏移。'
} || echo '     ✅ 未见校准无效/回退'
hr

# ── 4. 每射频发射功率上限（最直观的信号强弱势）─────────────────
echo ' [4] 各射频最大发射功率 / 信道'
for phy in /sys/class/ieee80211/phy*; do
  [ -d "$phy" ] || continue
  n=$(basename "$phy")
  echo "     --- $n ---"
  if command -v iw >/dev/null 2>&1; then
    iw phy "$n" info 2>/dev/null | grep -E '^\s*(MHz|.*dBm)' | head -6 | sed 's/^/       /'
    iw phy "$n" info 2>/dev/null | grep -iE 'txpower|HE160|HE80|HE40' | head -4 | sed 's/^/       /'
  fi
done
hr

# ── 5. 关联的终端（证明无线确实在收发）──────────────────────────
echo ' [5] 无线关联终端'
if command -v iw >/dev/null 2>&1; then
  for d in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do
    c=$(iw dev "$d" station dump 2>/dev/null | grep -c '^Station ' || true)
    echo "     $d : ${c:-0} 个终端"
  done
fi
hr
echo ' 验收建议：与原厂/NWRT 固件在同一位置、同一终端对比'
echo '   ① iw phy1 info 各信道 dBm 上限差值 ≤ 1dB'
echo '   ② 1 米 iperf3 5G 下行差值 ≤ 15%'
echo '   ③ 2.4G station dump 的 RSSI 差值 ≤ 3dB'
echo '============================================================'

# ── 6. 第 39 次：ART 实证状态（只读）─────────────────────────────
hr
echo ' [6] 本机 ART 校准实证（第 39 次）'
if [ -x /usr/sbin/wifi-art-cal ]; then
  /usr/sbin/wifi-art-cal status 2>/dev/null | sed 's/^/     /'
else
  echo '     wifi-art-cal 未安装（旧固件）；实证登记见 vs010/art-truth.conf'
fi
