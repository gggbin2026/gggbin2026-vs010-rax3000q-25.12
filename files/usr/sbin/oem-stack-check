#!/bin/sh
# oem-stack-check —— QSDK 12.2 好固件对照自检（第 41 次新增）
# 只读：不加载模块、不写 flash、不改 uci、不下载任何东西。
# 串口直接跑看人读报告；--json 给状态页用。
# 真值来源 /etc/config/oem-qsdk-truth.conf（编译期从 vs010/oem-qsdk-truth.conf 复制）。
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
TRUTH=/etc/config/oem-qsdk-truth.conf
line(){ echo "──────────────────────────────────────────────────────────"; }
say(){ echo "  $*"; }
has(){ command -v "$1" >/dev/null 2>&1; }
lsmod_has(){ lsmod 2>/dev/null | awk '{print $1}' | grep -qx "$1"; }
tget(){
    v=$(grep -E "^$1=" "$TRUTH" 2>/dev/null | head -1 | cut -d= -f2-)
    [ -n "$v" ] && { printf '%s' "$v"; return; }
    # 真值档案缺失（如离线跑脚本）时的内嵌兜底，避免打印空白
    case "$1" in
        KERNEL) printf '5.4.213' ;;
        QSDK) printf '12.2' ;;
        WIFI_FW_VERSION) printf 'WLAN.HK.2.8-01492-QCAHKSWPL_SILICONZ-1 v1' ;;
        K_NEWREPO) printf '6.12.x / OpenWrt 25.12 + NSS / 主线 ath11k + mac80211' ;;
    esac
}

JSON=0
[ "${1:-}" = "--json" ] && JSON=1

# ── 采样 ──────────────────────────────────────────────────────────
KVER=$(uname -r 2>/dev/null || echo '?')
QSDK_KO=''
for m in qca_ol umac wifi_3_0 ipq_cnss2 qca_ssdk ecm qca_nss_drv; do
    lsmod_has "$m" && QSDK_KO="$QSDK_KO $m"
done
[ -z "$QSDK_KO" ] && QSDK_KO='（无）'
QSDK_FILES=0
for f in /lib/firmware/IPQ5018/q6_fw.mdt /lib/firmware/IPQ5018/bdwlan.b10 \
         /lib/firmware/IPQ5018/qcn6122/bdwlan.b60 /lib/firmware/IPQ5018/caldata.bin \
         /lib/firmware/qcn6122/caldata_1.bin /lib/firmware/IPQ5018/board-2.bin; do
    [ -e "$f" ] && QSDK_FILES=$((QSDK_FILES+1))
done
NSS_DRV=0; NSS_ECM=0; ATH11K=0; MAC80211=0
lsmod_has qca_nss_drv && NSS_DRV=1
lsmod_has ecm || lsmod_has qca_nss_ecm && NSS_ECM=1
lsmod_has ath11k && ATH11K=1
lsmod_has mac80211 && MAC80211=1
ECM_NODE='（无）'
for d in /sys/kernel/debug/ecm/ecm_nss_ipv4 /sys/kernel/debug/ecm/ecm_sfe_ipv4 \
         /sys/kernel/debug/ecm/ecm_ppe_ipv4; do
    [ -d "$d" ] && ECM_NODE="$d"
done
PHY=$(ls /sys/class/ieee80211 2>/dev/null | tr '\n' ' ')
[ -z "$PHY" ] && PHY='（无）'
NETS=$(ls /sys/class/net 2>/dev/null | grep -E '^(eth|lan|wan|br-)' | tr '\n' ' ')

if [ "$JSON" = 1 ]; then
    printf '{"kernel":"%s","qsdk_ko":"%s","qsdk_files":%d,"nss_drv":%d,"nss_ecm":%d,"ath11k":%d,"mac80211":%d,"ecm_node":"%s","phy":"%s","verdict":"no-portable-binaries"}\n' \
        "$KVER" "$(echo "$QSDK_KO" | tr -s ' ' | sed 's/^ //')" "$QSDK_FILES" \
        "$NSS_DRV" "$NSS_ECM" "$ATH11K" "$MAC80211" "$ECM_NODE" "$(echo "$PHY" | tr -s ' ')"
    exit 0
fi

line
echo "═══ OEM QSDK 12.2 栈对照自检 · oem-stack-check ═══"
line
say "内核            : $KVER"
say "好固件内核      : $(tget KERNEL) / QSDK $(tget QSDK) / $(tget WIFI_FW_VERSION)"
say "本仓目标栈      : $(tget K_NEWREPO)"
say "QSDK 闭源 .ko   : $QSDK_KO"
say "QSDK 残留文件   : $QSDK_FILES 个（.ko / q6_fw / 单 BDF / caldata）"
say "NSS/ECM/ath11k  : drv=$NSS_DRV ecm=$NSS_ECM ath11k=$ATH11K mac80211=$MAC80211"
say "ECM debugfs     : $ECM_NODE"
say "PHY / 网口      : $PHY | $NETS"
line

say "结论（取证报告 docs/OEM-QSDK12.2-取证报告.md）"
say "· 好固件是 5.4.213 + 闭源 qca_ol/umac/ipq_cnss2；本仓是 6.12 + 主线 ath11k。"
say "  vermagic / 导出符号 / cfg80211 ABI 全不匹配，且两套无线栈互斥。"
say "· 因此【不能】把好固件的 .ko、q6_fw/m3_fw、bdwlan.bXX 单 BDF 拷过来加速："
say "  .ko 会 Invalid module format；WiFi FW 格式不同；单 BDF 不是 ath11k 的 board-2.bin 容器。"
if [ "$QSDK_FILES" -gt 0 ] || [ "$QSDK_KO" != '（无）' ]; then
    say "  ⚠ 本固件里检出了 QSDK 残留，若不是你手工放的，请检查编译输入。"
fi
if [ "$NSS_DRV" = 0 ] && [ "$NSS_ECM" = 0 ]; then
    say "· 未检测到 NSS/ECM 运行期模块：纯二层桥本来不走三层 offload，属预期；"
    say "  无线能不能 probe 看 BDF / board_id，与加速无关。"
else
    say "· 检测到 NSS/ECM：路由/NAT 场景才可能生效；WDS/AP 纯二层桥仍按二层转发。"
fi
say "· 判速口径：被卸载的流量【不经过 Linux 网桥】→ 看 eth0/eth1 + NSS debugfs，"
say "  不要看 br-lan；也不要用 br-lan 计数判断加速是否生效。"
say "· 可迁移的是工作方式：ECM→NSS 卸载、qca-ssdk 双 GMAC、NSS FW 12.5 优先、"
say "  wifi_offload、不加载独立 caldata、RPS 绑核口径 —— 本仓已按此落地。"
say "· 要真正达到好固件那种满速，现实路径是：直接用 NWRT 官方固件，或取得"
say "  QSDK 12.2 OEM 授权换 target 重编；不是往 6.12 主线塞 5.4 闭源件。"
line
say "真值档案 : /etc/config/oem-qsdk-truth.conf"
say "取证存档 : art/oem-qsdk-bdf/（离线，不进固件）"
say "本报告只读，不改任何配置。"
line
exit 0
