#!/bin/sh
# l2-guard —— 阻止「无线端」进来的 DHCP 服务器报文污染 br-lan
# 用法: l2-guard [apply|off|status|on]
#   apply  按 /etc/config/l2guard 重建独立 nft 表
#   off    删除本表（不影响系统其他 nft 规则，绝不 flush 全局）
#   status 打印状态，供状态页 CGI 调用
# 依赖: nftables + kmod-nft-bridge（common.seed 已编）；缺则跳过并如实报告。
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
CONF=/etc/config/l2guard
TABLE='nwrt_l2'
MARK=/tmp/l2guard.state
RULES=/tmp/l2guard.nft

cfg() {
    [ -f "$CONF" ] || { printf ''; return; }
    sed -n "s/^[[:space:]]*option[[:space:]]*$1[[:space:]]*'\([^']*\)'.*/\1/p" "$CONF" 2>/dev/null | head -1
}

have_nft() {
    command -v nft >/dev/null 2>&1 || return 1
    # 探测 bridge family 是否可用（不需要先建表，避免污染）
    nft list tables bridge >/dev/null 2>&1 || return 1
    return 0
}

build_rules() {
    PAT=$(cfg wlan_pattern); [ -n "$PAT" ] || PAT='wlan* phy*-ap*'
    DRY=$(cfg dryrun); V6=$(cfg dhcpv6)
    # 去重 + 转成 nft 集合字面量
    LIST=''
    for w in $PAT; do
        case "$LIST" in *"\"$w\""*) ;; *) LIST="$LIST\"$w\"," ;; esac
    done
    LIST=$(printf '%s' "$LIST" | sed 's/,$//')
    [ -n "$LIST" ] || LIST='"wlan*"'
    DROP='drop'; [ "$DRY" = '1' ] && DROP='log prefix "l2guard-rogue-dhcp: " accept'
    {
        echo "table bridge $TABLE {"
        echo '  chain guard {'
        echo '    type filter hook prerouting priority -150; policy accept;'
        echo "    iifname { $LIST } udp sport 67 udp dport 68 $DROP comment \"rogue DHCPv4 from wlan\""
        [ "$V6" = '1' ] && \
        echo "    iifname { $LIST } udp sport 547 udp dport 546 $DROP comment \"rogue DHCPv6 from wlan\""
        echo '  }'
        echo '}'
    } > "$RULES"
}

apply() {
    [ "$(cfg enabled)" = '1' ] || { off; echo 'l2-guard: disabled'; return 0; }
    if ! have_nft; then
        echo 'skip' > "$MARK"
        logger -t l2-guard 'nft/bridge 不可用，跳过（官方基线无此包时属预期）'
        echo 'l2-guard: nft bridge 不可用，已跳过'; return 0
    fi
    build_rules
    # 只重建自己的表，绝不 flush 全局 ruleset
    nft delete table bridge "$TABLE" 2>/dev/null || true
    if nft -f "$RULES" 2>/dev/null; then
        echo "applied pattern=\"$(cfg wlan_pattern)\" dryrun=$(cfg dryrun)" > "$MARK"
        logger -t l2-guard "无线端 DHCP 防护已启用"
        echo "l2-guard: 已启用，拦 [$(cfg wlan_pattern)] 的 67→68 / 547→546"
    else
        echo 'failed' > "$MARK"
        logger -t l2-guard 'nft 规则加载失败，已跳过（不影响开机）'
        echo 'l2-guard: 规则加载失败，已跳过'
    fi
}

off() {
    nft delete table bridge "$TABLE" 2>/dev/null || true
    echo 'off' > "$MARK"
    echo 'l2-guard: 已停用（仅删除本表）'
}

status() {
    [ -f "$MARK" ] && head -1 "$MARK" || echo 'unknown'
    if command -v nft >/dev/null 2>&1; then
        nft list table bridge "$TABLE" 2>/dev/null | grep -cE 'udp sport|drop|log prefix' || true
    else
        echo 'nft 未安装'
    fi
}

case "${1:-apply}" in
    apply)  apply ;;
    on)     sed -i "s/option enabled '0'/option enabled '1'/" "$CONF" 2>/dev/null || true; apply ;;
    off)    off ;;
    status) status ;;
    *) echo "用法: l2-guard [apply|off|status|on]" ;;
esac
