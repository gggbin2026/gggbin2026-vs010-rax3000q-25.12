#!/bin/sh
# wifi-stack-check —— 第 40 次：只读判定当前无线驱动栈 / 内核 / 换栈缺件
#   不联网、不改配置、不加载模块。目的是别再盲试「拷几个 .ko 就好」。
#   用法： wifi-stack-check [status|--json]
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
say(){ echo "[stack] $*"; logger -t wifi-stack "$*" 2>/dev/null || true; }
K=$(uname -r 2>/dev/null || echo unknown)
MODEL=$(cat /tmp/sysinfo/board_name 2>/dev/null || cat /proc/device-tree/model 2>/dev/null | tr -d '\0' || echo unknown)
MODE=$(cat /etc/firmware_mode 2>/dev/null || echo unknown)
CFG=/etc/config/oem-stack-truth.conf
[ -r "$CFG" ] || CFG=/rom/etc/config/oem-stack-truth.conf

loaded(){ grep -qE "^$1[[:space:]]" /proc/modules 2>/dev/null && echo 1 || echo 0; }
have(){ [ -e "$1" ] && echo 1 || echo 0; }

A=$(loaded ath11k); M=$(loaded mac80211); C=$(loaded cfg80211)
O=$(loaded qca_ol); U=$(loaded umac); W=$(loaded wifi_3_0)
N=$(loaded qca_nss_drv); S=$(loaded qca_ssdk); E=$(loaded ecm)
CN=$(loaded ipq_cnss2)
WFW=$(have /lib/firmware/IPQ5018/bdwlan.b10)
B2=$(have /lib/firmware/ath11k/IPQ5018/hw1.0/board-2.bin)
B5=$(have /lib/firmware/ath11k/QCN6122/hw1.0/board-2.bin)
DAEMON=$(have /usr/sbin/qca-cnss-daemon)
WIFITOOL=$(have /usr/sbin/wifitool)
FWMOUNT=$(have /etc/init.d/wifi_fw_mount)

say "机型        : $MODEL   模式: $MODE"
say "运行内核    : $K"
say "本仓基线    : 5.4.164 / NHSS.11.5 / QSDK 11.5（kkstone immortalwrt-ipq50xx）"
say "好固件基线  : 5.4.213 / QSDK 12.2（NWRT 2024-04-16，无线正常）"
say "已解 OEM 栈 : 4.4.60 / QSDK 10.4（离线归档，不进编译树）"
echo
say "── 当前已加载 ──"
say "  开源 ath11k 栈 : ath11k=$A  mac80211=$M  cfg80211=$C"
say "  闭源 qca-wifi  : qca_ol=$O  umac=$U  wifi_3_0=$W  ipq_cnss2=$CN"
say "  NSS 加速       : qca-nss-drv=$N  qca-ssdk=$S  ecm=$E"
echo
say "── 关键文件 ──"
say "  ath11k board-2.bin : 2.4G=$B2  5G(大写 QCN6122)=$B5"
say "  cnss2 bdwlan.b10   : $WFW"
say "  qca-cnss-daemon    : $DAEMON   wifitool=$WIFITOOL   wifi_fw_mount=$FWMOUNT"
echo
if [ "$O" = 1 ] || [ "$U" = 1 ] || [ "$W" = 1 ]; then
  case "$K" in
    *5.4.213*)
      say "★ 结论: 当前是【官方 NWRT QSDK12.2 / 5.4.213 满血闭源栈】"
      say "  无线 + NSS 加速已就位（第 41 次修复路径生效）。"
      say "  验收：iw dev / wlanconfig ath0 list / wifitool ath0 status / dmesg | grep 'BDF version'"
      say "  叠加本仓定制：sh oem54/apply-oem-overlay.sh（见 oem54/README_无线修复.md）"
      say "  ⚠ 下面「为什么不能靠拷 .ko」「要真修好还缺」两节适用于【本仓编译固件】，本设备不适用。"
      ;;
    *)
      say "结论: 当前是【闭源 qca-wifi 栈】—— 本工具不改动它。"
      ;;
  esac
elif [ "$A" = 1 ]; then
  say "结论: 当前是【开源 ath11k 栈】（本仓默认，5.4.164 / NHSS.11.5）。"
  say "  要无线满血：刷 3000Q-VS010-固件/ 下对应机型的 NWRT 官方 5.4.213 固件，"
  say "  再 sh oem54/apply-oem-overlay.sh 叠加本仓定制（第 41 次）。"
else
  say "结论: 未检测到任何无线驱动模块（可能未 probe / 模块未加载）。"
fi
echo
say "── 为什么不能靠「拷 .ko」修到满血 ──"
say "  ① 三套内核互不相同：4.4.60 / 5.4.164 / 5.4.213，vermagic 与导出符号全不匹配"
say "  ② 闭源 qca-wifi 与 ath11k+mac80211 共用 cfg80211，互斥，不能并存"
say "  ③ 还缺 ipq_cnss2 + QMI WLFW + qca-cnss-daemon + qca-qmi-framework + qca-hostap + wifi_fw_mount"
say "  ④ 本仓 feeds 只有 immortalwrt 四源，没有 QSDK 闭源包；四份 .config 也无 kmod-qca-wifi* 可选项"
echo
say "── 固件不是瓶颈（第 40 次实证）──"
say "  4.4.60 的 wifi_fw 卷 52 个固件，与 5.4 成功态日志 58 个里 52 个【逐字相同】"
say "  5.4 只多 Data.msc / fw_ini_cfg.bin / regdb.bin（及 qcn6122 三份副本）"
say "  本仓已落 bdwlan.b10/b60 与 ath11k board-2.bin，BDF/Q6/M3 不缺"
echo
say "── 要真修好，还缺（三选一）──"
say "  1) 把 NWRT 26MB 整包 / 或 /lib/firmware/IPQ5018 全目录 + 全部 .ko + lsmod +"
say "     /proc/config.gz + uname -a 传到能直连处（GitHub Release 最佳；网盘被网关 403 拦）"
say "  2) 取得 QSDK 12.2 OEM 授权 + qca src/linux-5.4 整套源码树 + 闭源 feed，换 target 重编"
say "  3) 直接用 NWRT 官方固件"
echo
say "只读工具，未修改任何文件。详细登记见 /etc/config/oem-stack-truth.conf"
