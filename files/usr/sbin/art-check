#!/bin/sh
# art-check —— 实机只读自检 0:ART（不改 flash、不改配置、不重启）
# 用法：art-check  或  sh /usr/sbin/art-check
#
# 回答四件事：
#   ① 有没有 0:ART 分区、是不是完整 1 MB
#   ② 整片 MD5 与 art/art-truth.conf 里哪台机器对得上
#   ③ 头 4 个 MAC、@0x1000 / @0x26800 两份 128KB 切片的 MD5
#   ④ 该不该开 caldata（默认结论：不该，见末尾说明）
#
# 真值来源：/etc/art-truth.conf（由 board-inject.sh 从 art/art-truth.conf 复制）
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
say(){ printf '%s\n' "$*"; }
line(){ printf '%s\n' '──────────────────────────────────────────────────────────'; }
TRUTH=/etc/art-truth.conf
TMP=/tmp/art-check.bin

say "======== ART 自检 · $(date '+%Y-%m-%d %H:%M:%S') ========"
line

# ── ① 定位 0:ART ────────────────────────────────────────────────
MTDNAME=$(awk -F'[: "]' '/"(0:ART|0:art|ART|art)"/ {print $4; exit}' /proc/mtd 2>/dev/null || true)
MTDDEV=''
if [ -n "$MTDNAME" ] && [ -e "/dev/$MTDNAME" ]; then
  MTDDEV="/dev/$MTDNAME"
else
  for n in $(awk -F: '/mtd[0-9]+/ {print $1}' /proc/mtd 2>/dev/null); do
    lbl=$(grep "$n" /proc/mtd 2>/dev/null | grep -oE '"[^"]+"' | tail -1)
    case "$lbl" in *ART*|*art*) MTDDEV="/dev/$n"; MTDNAME="$n ($lbl)"; break ;; esac
  done
fi
if [ -z "$MTDDEV" ]; then
  say "  ✗ 找不到 0:ART 分区（/proc/mtd 里没有 ART 标签）"
  say "    本机可能不是这两台机器，或分区名不同；把 cat /proc/mtd 贴回来"
  line; exit 0
fi
say "  分区   : $MTDDEV  $MTDNAME"
dd if="$MTDDEV" of="$TMP" bs=65536 count=16 2>/dev/null || {
  say "  ✗ 读 0:ART 失败（权限/坏块）"; line; exit 0; }
SZ=$(wc -c < "$TMP" 2>/dev/null || echo 0)
MD5=$(md5sum "$TMP" 2>/dev/null | awk '{print $1}')
say "  大小   : $SZ B $([ "$SZ" -ge 1048576 ] && echo '✓ 完整 1MB' || echo '⚠ 不足 1MB')"
say "  整片MD5: $MD5"
line

# ── ② 与采集真值比对 ────────────────────────────────────────────
MATCH='未匹配（别的机器 / ART 被换过 / 采集时不是这台）'
if [ -f "$TRUTH" ]; then
  v=$(grep -E '^ART_VS010_MD5=' "$TRUTH" | cut -d= -f2)
  r=$(grep -E '^ART_RAX3000Q_MD5=' "$TRUTH" | cut -d= -f2)
  [ "$MD5" = "$v" ] && MATCH='VS010（010-smem_0-ART.bin）'
  [ "$MD5" = "$r" ] && MATCH='RAX3000Q（RAX3000Q-mtd13-0ART）'
else
  MATCH='真值文件缺失（/etc/art-truth.conf 没进固件）'
fi
say "  机型判定: $MATCH"

# ── ③ 头 MAC + 两份切片 ─────────────────────────────────────────
HEAD=$(od -An -tx1 -j0 -N24 "$TMP" 2>/dev/null | tr -s ' ' | sed 's/^ //')
say "  头24字节: $HEAD"
# 纯 shell 提取 4 个 MAC（避免依赖 python）
for off in 0 6 12 18; do
  H=$(od -An -tx1 -j "$off" -N6 "$TMP" 2>/dev/null | tr -d ' \n' | tr 'a-f' 'A-F')
  [ -z "$H" ] && continue
  case "$H" in
    FFFFFFFFFFFF|000000000000) say "  MAC@$off : —（全 FF / 空）" ;;
    *) say "  MAC@$off : $(printf '%s' "$H" | sed 's/../&:/g;s/:$//')" ;;
  esac
done
line
say "  128KB 切片（bs=2048）"
for spec in '2G 2' '5G 77'; do
  set -- $spec
  R="$1"; SK="$2"
  M=$(dd if="$TMP" bs=2048 skip="$SK" count=64 2>/dev/null | md5sum 2>/dev/null | awk '{print $1}')
  MG=$(dd if="$TMP" bs=2048 skip="$SK" count=1 2>/dev/null | od -An -tx1 -N4 2>/dev/null | tr -d ' \n')
  say "  $R @0x$(printf '%x' $((SK*2048))) : md5=${M:-未读到}  magic=${MG:-?}"
  if [ -f "$TRUTH" ]; then
    for k in VS010 RAX3000Q; do
      key="ART_${k}_BDF${R}_MD5"
      exp=$(grep -E "^${key}=" "$TRUTH" | cut -d= -f2)
      [ -n "$exp" ] && [ "$M" = "$exp" ] && say "      ✓ 与 $k 采集值一致"
    done
  fi
done
line

# ── ④ 无线 MAC（实机日志：好固件 5G 用了 BDF 占位 00:03:7F:12:EF:EF）──
line
say "  无线 MAC（实机对照）"
WMAC=''
if command -v iw >/dev/null 2>&1; then
  WMAC=$(iw dev 2>/dev/null | awk '/addr/{print $2}' | sort -u | tr '\n' ' ')
fi
[ -z "$WMAC" ] && WMAC='（未读到 / 无线未起）'
say "  iw dev : $WMAC"
WMACU=$(printf '%s' "$WMAC" | tr 'a-f' 'A-F')
case "$WMACU" in
  *00:03:7F:12*|*FF:FF:FF*)
    say "  ⚠ 命中 BDF 占位 MAC 家族 00:03:7F:12:xx:xx —— 实机好固件的 5G 也是这样"
    say "    （00:03:7F:12:EF:EF），ART 头的真 MAC 没被无线用。若影响漫游/认证，"
    say "    从机身标签或 0:APPSBLENV 取 MAC，用"
    say "    uci set wireless.default_radio0.macaddr=... && uci commit wireless 固化。"
    say "    本脚本不自动写 MAC（避免编造）。" ;;
  *) say "  ✓ 未命中占位家族" ;;
esac
line

# ── ⑤ 结论 ──────────────────────────────────────────────────────
say "  结论与建议"
say "  · 两份切片 magic 应为 01000404；不是就说明偏移不适用这台板子。"
say "  · VS010 头有 4 个单播 MAC，DTS 的 macaddr@0 / @6 与之对应，无需改。"
say "  · RAX3000Q 头是全 FF：不能像 VS010 那样从 ART+0 取 MAC。"
say "  · ★ 实机日志（/etc 旁的 oem-bootlog / art/oem-bootlog.txt）实证："
say "    好固件下载 IPQ5018/bdwlan.b10 与 qcn6122/bdwlan.b60（各 131072 B），"
say "    MD5 == 模板 BDF；Caldata not present / CAL version 0 → ART 切片没被加载。"
say "    ★ 因此【本机校准的 data 用模板 BDF】，不是 ART 切片；用"
say "    art/make-board2.py from-oem 造容器，别拿 slice 产物进固件。"
say "  · ★ 默认【不启用 caldata / 不引用 ART】：改已验证能工作的链路风险大于收益。"
say "    想启用就编译期 ART_CALIBRATION=1，编完 TTL 验证射频再定；"
say "    不要在运行期往 /lib/firmware 塞 caldata.bin。"
say "  · 驱动栈提醒：好固件是 qca_ol/umac/ipq_cnss2 闭源栈（lsmod 无 ath11k），"
say "    它的 mem mode [2] / platform name 不能直接抄进主线 ath11k DTS。"
say "  · ART 校准逐台不同：只用于你这台，别把一机切片刷到另一机。"
say "  · 采集真值见 /etc/art-truth.conf；离线复核：sh art/collect.sh"
line
rm -f "$TMP" 2>/dev/null || true
exit 0
