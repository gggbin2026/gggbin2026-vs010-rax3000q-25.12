#!/bin/sh
# tty-diag —— 一条命令定位「进系统后串口按不动」
# 用法：串口里敲  tty-diag  （若连这个都敲不进，先按一次回车 / 查 RX 与流控）
TTY=ttyMSM0
echo "========== tty-diag $(date) =========="
echo "--- 1. 内核 console 参数 ---"
cat /proc/cmdline
echo "    /sys/class/tty/console/active = $(cat /sys/class/tty/console/active 2>/dev/null || echo 读不到)"
echo "--- 2. /dev 节点（最关键）---"
ls -l /dev/console "/dev/$TTY" 2>&1
echo "    sysfs dev 号 = $(cat /sys/class/tty/$TTY/dev 2>/dev/null || echo 读不到)"
echo "--- 3. inittab ---"
cat /etc/inittab
echo "--- 4. login 进程在不在 ---"
ps w | grep -E '[l]ogin.sh|[a]sh --login|[g]etty' || echo '!! 没有 login 进程 = procd 没 spawn 成功'
echo "--- 5. termios / 流控 ---"
if command -v stty >/dev/null 2>&1 && [ -e "/dev/$TTY" ]; then
    stty -F "/dev/$TTY" -a 2>&1 | head -8
else
    echo 'stty 不可用（本版已强制编入，出现这行说明固件不是新版）'
fi
echo "--- 6. ttylogin / shadow ---"
echo "    ttylogin = $(uci -q get system.@system[0].ttylogin || echo 未设→ash --login)"
echo "--- 7. procd ---"
echo "    pid1 = $(cat /proc/1/comm)"
echo "--- 8. 首次开机还在跑吗 ---"
ps w | grep -E '[d]ropbearkey|[w]ifi|[h]ostapd|[s]ysntpd' || echo '(无阻塞进程)'
echo "========== 判读 =========="
echo "  节点缺    → 刷的包没带 DEVTMPFS=y，或 procd 冷扫没建；本版已修"
echo "  无 login  → 看 inittab 是否写死 ttyMSM0；再敲一次回车(askfirst 语义)"
echo "  crtscts   → PC 串口工具也要关硬件流控，两边都要关"
echo "  -echo/raw → 本版 uci-defaults 已 stty sane 复位"
echo "  以上全 OK 仍不动 → 100% 是 RX 线 / TX-RX 接反 / 未共地 / PC 侧流控"
