#!/bin/sh
# luci-entry —— 可选：把状态页入口加进 LuCI 主题页脚
#
# 【2026-11-24 改：默认不注入】老仓库「主题页面进不去」有一类根因就是开机
# 脚本往 /usr/lib/lua/luci/view/themes/*/footer.htm 里塞 HTML：25.12 的 LuCI
# 已转向 ucode 模板，路径、语法、只读 squashfs 任一不对就会把模板写坏，
# 之后 /cgi-bin/luci 直接 500。状态页本来就是独立静态页（/bridge/、/ap/），
# 不依赖 LuCI，少改一个文件就少一个报错点。
#
# 现在必须显式开启才会动模板：
#   touch /etc/luci-entry-enable && /usr/sbin/luci-entry
# 默认（无标记文件）只打一行日志后退出，绝不碰任何主题文件。
# 三个状态页仍可直接访问，页面底部也有指向 /cgi-bin/luci 的按钮。
#
# 全程只读判断；失败只记日志，绝不阻断开机。

LOG() { logger -t luci-entry "$*" 2>/dev/null || true; }

# 显式开关：没有标记文件就完全不碰主题模板（这是「页面不报错」的关键）
if [ ! -f /etc/luci-entry-enable ]; then
    LOG "未开启（默认）：不修改任何主题模板；状态页仍可直接访问 /bridge/ /ap/"
    echo "luci-entry: 默认不注入。要开启：touch /etc/luci-entry-enable && luci-entry"
    exit 0
fi

# 按固件模式选入口（WDS 网桥版 / 普通 AP 版）
if [ "$(cat /etc/firmware_mode 2>/dev/null)" = 'ap' ]; then
    PAGE='/ap/'; CGI='/cgi-bin/apstatus'; TITLE='AP 控制台'
else
    PAGE='/bridge/'; CGI='/cgi-bin/bridge'; TITLE='网桥状态'
fi

BLOCK="<!-- BRIDGE_STATUS_ENTRY_BEGIN -->
<div style=\"margin:16px 0 6px;padding:10px 14px;border:1px solid #2b3d55;border-radius:10px;background:rgba(78,161,255,.08);font-size:12px;color:#8ea3bd;line-height:1.7\">
  <a href=\"$PAGE\" style=\"color:#4ea1ff;text-decoration:none;font-weight:650\">$TITLE</a>
  &nbsp;·&nbsp; <a href=\"$CGI\" style=\"color:#8ea3bd;text-decoration:none\">JSON 数据源</a>
  &nbsp;·&nbsp; 只读页面，不修改任何配置 &nbsp;·&nbsp; 由 luci-entry 注入（可手动重跑）
</div>
<!-- BRIDGE_STATUS_ENTRY_END -->"

# 主题模板探测：ARGON 优先，bootstrap 兜底；只注入第一个命中的文件
TPL=''
for f in \
    /usr/lib/lua/luci/view/themes/argon/footer.htm \
    /usr/lib/lua/luci/view/themes/argon/header.htm \
    /usr/lib/lua/luci/view/themes/argon_mod/footer.htm \
    /usr/lib/lua/luci/view/themes/bootstrap/footer.htm ; do
    if [ -f "$f" ]; then TPL="$f"; break; fi
done

if [ -z "$TPL" ]; then
    LOG "未找到 LuCI 主题模板（argon/bootstrap 均未安装），跳过入口注入；状态页仍可直接访问 $PAGE"
    echo "luci-entry: 未找到主题模板，跳过（状态页 $PAGE 仍可直接访问）"
    exit 0
fi

if [ ! -w "$TPL" ]; then
    LOG "$TPL 不可写，跳过"
    echo "luci-entry: $TPL 不可写，跳过"
    exit 0
fi

TMP="${TPL}.bridge-entry.tmp"
# ① 删掉旧标记块（模式切换后能换链接）② 在 </body> 前插入；无 </body> 则追加末尾
awk -v block="$BLOCK" '
    BEGIN { skip=0; inserted=0 }
    /<!-- BRIDGE_STATUS_ENTRY_BEGIN -->/ { skip=1; next }
    /<!-- BRIDGE_STATUS_ENTRY_END -->/   { skip=0; next }
    skip { next }
    { lines[++n]=$0 }
    END {
        for (i=1; i<=n; i++) {
            if (inserted==0 && lines[i] ~ /<\/body>/) { print block; inserted=1 }
            print lines[i]
        }
        if (inserted==0) print block
    }
' "$TPL" > "$TMP" 2>/dev/null

if [ ! -s "$TMP" ]; then
    rm -f "$TMP" 2>/dev/null || true
    LOG "awk 处理失败，已放弃，原模板未改动"
    exit 0
fi

if grep -q 'BRIDGE_STATUS_ENTRY_BEGIN' "$TMP" 2>/dev/null; then
    mv "$TMP" "$TPL" 2>/dev/null || {
        rm -f "$TMP" 2>/dev/null || true
        LOG "mv 失败（只读文件系统？），原模板未改动"
        exit 0
    }
    LOG "已在 $TPL 注入「$TITLE」入口 → $PAGE"
    echo "luci-entry: ✓ $TPL 已注入入口 → $PAGE"
else
    rm -f "$TMP" 2>/dev/null || true
    LOG "标记块未写入，原模板未改动"
fi
exit 0
