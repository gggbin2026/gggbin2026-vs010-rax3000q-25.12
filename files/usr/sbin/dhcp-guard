#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════
# dhcp-guard —— 无线 DHCP Snooping（防「无线客户端私开 DHCP 抢答」）
#
# 用法（串口）：
#   sh /usr/sbin/dhcp-guard            # 应用防护（幂等，可反复跑）
#   sh /usr/sbin/dhcp-guard --status   # 看当前能力与规则，不改动
#   sh /usr/sbin/dhcp-guard --off      # 完整撤除（规则 + 历史隔离残留 + uci）
#   sh /usr/sbin/dhcp-guard --json     # 机器可读结论
#
# ★ 本轮变更（用户要求）：【不要无线用户隔离】
#   · 不再设置 hostapd ap_isolate=1
#   · 不再下发 bridge link ... isolated on
#   · 保留/启用过的隔离残留会【主动清掉】
#   → 无线客户端之间互访完全正常：投屏、无线打印机、局域网共享/对战都可用
#
# 保留的能力（这才是防私设 DHCP 的正解）：
#   按【物理入接口】丢弃 wlan* 进来的 DHCP 服务端报文（UDP 源端口 67：
#   OFFER / ACK / NAK）。它只拦 DHCP 应答，不拦任何普通流量，
#   所以既防抢答，又不影响无线用户互访。
#
# 端口模型（纯二层桥 br-lan，eth0/eth1 + 2.4G + 5G 同一个广播域）：
#   信任   = eth0 / eth1（上联 / 本机 dnsmasq 所在）
#   不信任 = wlan*（所有无线客户端）
#
# 三条「不影响」：
#   · 这台 AP：本机 dnsmasq 的 OFFER 走 OUTPUT，不经 FORWARD，规则不碰
#   · 其它无线用户：DISCOVER/REQUEST（源端口 68）放行，正常上网
#   · 上级/主端：OFFER 从 eth 进，不在丢弃范围
#
# 能力探测（自动，不用手选）：
#   ① ebtables + kmod-ebtables-ipv4      → 真·DHCP Snooping（本轮默认已编译）
#   ② nft + kmod-nft-bridge              → 真·DHCP Snooping
#   ③ br_netfilter + iptables physdev    → 真·DHCP Snooping
#   ④ 都没有                            → 缓解模式（只有 authoritative），如实标注
#
# ⚠ 一个如实边界（去掉隔离后的取舍）：
#   绝大多数 Linux 网桥实现里，STA↔STA 帧经 br-lan 的 FORWARD 链，
#   ebtables 能拦住同 SSID 的 DHCP 67。但【部分闭源无线驱动会做 intra-BSS
#   hairpin 直接转发】，这部分帧不经过 bridge，ebtables 看不见。
#   现场验证方法见 README 第六节；若实测漏过，给重要终端设静态 IP，
#   或用 nft netdev ingress hook（需另加 nftables）补，不再用客户端隔离。
#
# 全程可重复、不改编译期文件、不写 flash、不重启网络；由 rc.local 开机调用。
# ═══════════════════════════════════════════════════════════════════════
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
TAG=dhcp-guard
CHAIN=DHCPGUARD
TRUST='eth0 eth1'          # 信任端口（可用 DHCPGUARD_TRUST 环境变量覆盖）
[ -n "$DHCPGUARD_TRUST" ] && TRUST="$DHCPGUARD_TRUST"

say(){ printf '%s\n' "$*"; logger -t "$TAG" "$*" 2>/dev/null || true; }
line(){ printf '%s\n' '──────────────────────────────────────────────────────────'; }
MODE=$(cat /etc/firmware_mode 2>/dev/null || echo '?')
ROLE=$(cat /etc/bridge_role_mode 2>/dev/null || echo '')
LANIP=$(uci -q get network.lan.ipaddr 2>/dev/null || echo '?')
DHCP_IGNORE=$(uci -q get dhcp.lan.ignore 2>/dev/null || echo '0')

# 枚举真实无线口（wifi-heal 之后才有）；没有就回落通配
list_wlan(){
    _s=''
    for _p in /sys/class/net/wlan*; do
        [ -e "$_p" ] || continue
        _s="$_s ${_p##*/}"
    done
    [ -n "$_s" ] && { echo $_s; return 0; }
    echo 'wlan+'
}

# ── 能力探测（本轮已移除 AP 端口隔离档）────────────────────────────
CAP='none'
if command -v ebtables >/dev/null 2>&1 && ebtables -L >/dev/null 2>&1; then
    CAP='ebtables'
elif command -v nft >/dev/null 2>&1 && nft list tables bridge >/dev/null 2>&1; then
    CAP='nft'
elif [ -e /proc/sys/net/bridge/bridge-nf-call-iptables ] \
     && command -v iptables >/dev/null 2>&1 \
     && iptables -m physdev --help >/dev/null 2>&1; then
    CAP='physdev'
fi

# ── 撤规则 ─────────────────────────────────────────────────────────
clear_rules(){
    case "$1" in
      ebtables)
        _i=0; while [ $_i -lt 8 ] && ebtables -D FORWARD -j "$CHAIN" >/dev/null 2>&1; do _i=$((_i+1)); done
        ebtables -F "$CHAIN" >/dev/null 2>&1 || true
        ebtables -X "$CHAIN" >/dev/null 2>&1 || true ;;
      nft)
        nft delete table bridge dhcp_guard >/dev/null 2>&1 || true ;;
      physdev)
        _i=0; while [ $_i -lt 8 ] && iptables -D FORWARD -j "$CHAIN" >/dev/null 2>&1; do _i=$((_i+1)); done
        iptables -F "$CHAIN" >/dev/null 2>&1 || true
        iptables -X "$CHAIN" >/dev/null 2>&1 || true ;;
    esac
}

# ── 真 DHCP Snooping 规则（只丢 wlan* 进来的 UDP sport 67）──────────
apply_rules(){
    case "$CAP" in
      ebtables)
        clear_rules ebtables
        ebtables -N "$CHAIN" -P RETURN >/dev/null 2>&1 || return 1
        ebtables -F "$CHAIN" >/dev/null 2>&1 || true
        _ok=0
        for _w in $(list_wlan); do
            if ebtables -A "$CHAIN" -p IPv4 --ip-proto udp --ip-source-port 67 \
                     --in-if "$_w" -j DROP >/dev/null 2>&1; then _ok=$((_ok+1)); fi
        done
        [ "$_ok" -gt 0 ] || { say "  ✗ ebtables 规则一条都没加上（内核模块可能没加载）"; return 1; }
        ebtables -I FORWARD 1 -j "$CHAIN" >/dev/null 2>&1 || return 1
        say "  ✓ ebtables：丢弃从 wlan* 进入的 UDP sport 67（OFFER/ACK/NAK）"
        say "    信任端口 $TRUST 的 67 放行；本机 dnsmasq 走 OUTPUT 不受影响；"
        say "    客户端 DISCOVER/REQUEST（sport 68）放行；普通流量一律不碰。"
        ebtables -L "$CHAIN" 2>/dev/null | sed 's/^/    /' ;;
      nft)
        nft delete table bridge dhcp_guard >/dev/null 2>&1 || true
        nft add table bridge dhcp_guard 2>/dev/null || return 1
        nft add chain bridge dhcp_guard forward \
            '{ type filter hook forward priority -200 ; }' 2>/dev/null || return 1
        nft add rule bridge dhcp_guard forward iifname "wlan*" udp sport 67 drop 2>/dev/null || return 1
        say "  ✓ nft bridge family：丢弃 iifname wlan* / udp sport 67" ;;
      physdev)
        sysctl -w net.bridge.bridge-nf-call-iptables=1 >/dev/null 2>&1 || return 1
        clear_rules physdev
        iptables -N "$CHAIN" >/dev/null 2>&1 || return 1
        iptables -F "$CHAIN" >/dev/null 2>&1 || true
        iptables -A "$CHAIN" -p udp --sport 67 -m physdev --physdev-in wlan+ -j DROP 2>/dev/null || return 1
        iptables -I FORWARD 1 -j "$CHAIN" >/dev/null 2>&1 || return 1
        say "  ✓ iptables physdev：按物理入端口 wlan+ 丢弃 UDP 67" ;;
    esac
}

# ── 主动清理历史隔离残留 ───────────────────────────────────────────
# 上一版曾写过 wireless.*.isolate=1；只要用户「不要隔离」，这里就清掉。
# 不做任何 set isolate，也不碰 bridge 的 isolated 标志（若旧会话设过也撤）。
purge_isolation(){
    _n=0
    if command -v uci >/dev/null 2>&1 && [ -s /etc/config/wireless ]; then
        for _sec in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface/\1/p'); do
            _v=$(uci -q get "wireless.$_sec.isolate" 2>/dev/null || echo '')
            [ -n "$_v" ] || continue
            uci -q delete "wireless.$_sec.isolate" 2>/dev/null || true
            _n=$((_n+1))
        done
        [ "$_n" -gt 0 ] && uci -q commit wireless 2>/dev/null || true
        [ "$_n" -gt 0 ] && ( /sbin/wifi reload >/dev/null 2>&1 || wifi reload >/dev/null 2>&1 || true )
    fi
    # 清掉可能残留的桥端口 isolated 标志（幂等，无 bridge 命令时跳过）
    if command -v bridge >/dev/null 2>&1; then
        for _w in $(list_wlan); do
            [ "${_w%\+}" = "$_w" ] && bridge link set dev "$_w" isolated off >/dev/null 2>&1 || true
        done
    fi
    if [ "$_n" -gt 0 ]; then
        say "  · 已清除 $_n 个历史 ap_isolate 残留（无线客户端互访恢复）"
    else
        say "  · 无线客户端隔离：未启用（互访正常）"
    fi
}

# ── 缓解模式（无二层过滤能力时）────────────────────────────────────
apply_mitigation(){
    say "  ⚠ 当前内核没有 ebtables / nft-bridge / br_netfilter+physdev，无法做真 Snooping"
    say "    落【缓解模式】（不重编也只能纠正，挡不住首次 DISCOVER 抢答）："
    if [ "$DHCP_IGNORE" != '1' ] && command -v uci >/dev/null 2>&1; then
        uci -q set dhcp.lan.authoritative='1' 2>/dev/null || true
        uci -q commit dhcp 2>/dev/null || true
        [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
        say "    · dnsmasq authoritative=1：对非本租约表的 REQUEST 发 NAK，纠正被带偏的地址"
    else
        say "    · 本机 DHCP 服务端是关的（备端 / AP 模式），authoritative 不适用，跳过"
    fi
    say "    · 按你的要求【不做无线客户端隔离】，无线侧没有额外防护"
    say "    · 要完整防护：本轮固件已默认打开 ebtables，重新编译刷入即自动升级"
    say "    · 过渡期建议给网内重要电脑设静态 IP"
}

# ── 状态输出 ───────────────────────────────────────────────────────
report(){
    say "════ 无线 DHCP Snooping · dhcp-guard ════"
    line
    say "固件模式 : $MODE ${ROLE:+（角色 $ROLE）}   管理 IP : $LANIP"
    say "本机 DHCP: $([ "$DHCP_IGNORE" = '1' ] && echo '关（上级/主端分配）' || echo '开（dnsmasq）')"
    say "信任端口 : $TRUST      不信任端口 : wlan*（无线客户端）"
    say "二层能力 : $CAP"
    say "  规则：丢弃 wlan* 进来的 UDP 67（OFFER/ACK/NAK）；68 放行；"
    say "        eth 的 67 放行；本机 dnsmasq 走 OUTPUT 不受影响。"
    say "  无线客户端隔离：❌ 未启用（投屏 / 无线打印机 / 互访正常）"
    line
}

case "${1:-apply}" in
  --off)
    clear_rules "$CAP"
    purge_isolation
    uci -q delete dhcp.lan.authoritative 2>/dev/null || true
    uci -q commit dhcp 2>/dev/null || true
    say "已完整撤除：规则 / 历史隔离残留 / authoritative（排障用）"
    exit 0 ;;
  --status)
    report
    case "$CAP" in
      ebtables) say "当前规则："; ebtables -L "$CHAIN" 2>/dev/null | sed 's/^/  /' || say "  （无自定义链）" ;;
      nft)      say "当前规则："; nft list table bridge dhcp_guard 2>/dev/null | sed 's/^/  /' || say "  （无表）" ;;
      physdev)  say "当前规则："; iptables -L "$CHAIN" -n 2>/dev/null | sed 's/^/  /' || say "  （无链）" ;;
      *)        say "当前模式：缓解（非完整 Snooping）" ;;
    esac
    say "隔离残留检查："; uci -q show wireless 2>/dev/null | grep isolate | sed 's/^/  /' || say "  （无，互访正常）"
    exit 0 ;;
  --json)
    case "$CAP" in
      ebtables|nft|physdev) _full=1 ;;
      *) _full=0 ;;
    esac
    printf '{"mode":"%s","role":"%s","lan_ip":"%s","dhcp_ignore":"%s","capability":"%s","full_snooping":%s,"wireless_isolated":0}\n' \
      "$MODE" "$ROLE" "$LANIP" "$DHCP_IGNORE" "$CAP" "$_full"
    exit 0 ;;
  apply|'') ;;
  *) say "用法: dhcp-guard [--status|--off|--json]"; exit 1 ;;
esac

report
# 不管走哪一档，都先把历史隔离残留清掉（用户明确不要隔离）
purge_isolation
if [ "$CAP" = 'none' ]; then
    apply_mitigation
    say ""
    say "结论：当前为【缓解模式】，不是完整 DHCP Snooping。"
else
    apply_rules || { say "  ✗ 下规则失败，转缓解模式"; apply_mitigation; CAP=none; }
    if [ "$CAP" != 'none' ]; then
        say ""
        say "结论：✅ 无线 DHCP Snooping 已生效（未启用无线客户端隔离）"
        say "      私设 DHCP 的 OFFER/ACK 被丢弃；无线用户之间互访完全不受影响"
    fi
fi
line
say "验证：dhcp-guard --status   撤除：dhcp-guard --off   整机自检：health-fix"
exit 0
