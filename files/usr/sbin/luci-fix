#!/bin/sh
# luci-fix —— 修复 /usr/lib/lua/luci/dispatcher.lua:427
#   "/etc/config/luci seems to be corrupt, unable to find section 'main'"
#
# 【为什么第 17 次校准没拦住 / 第 22 次必须做成"每次开机"】
# /etc/config/luci 是 luci-base 的 conffile。编译期 files/etc/config/luci 虽已
# 打包标准 `config core 'main'`，但只要用 sysupgrade 且勾了「保留配置」、
# 或 factory 刷后 overlay 里残留旧文件，旧配置就会盖掉编译期文件。
# 而重建逻辑原先只写在 99-bridge-ready（uci-defaults）——它【只在首次开机跑一次，
# 跑完删自己】，保留配置升级时根本不执行，于是坏文件一直留着，报错照旧。
#
# 本脚本不依赖 uci-defaults：由 /etc/init.d/bridge-netfix 每次冷启调用，
# 也可以串口手动跑 `luci-fix`，修完立刻刷新浏览器即可，不用重刷固件。
#
# 判定条件刻意放宽：不是只看文件是否存在，而是必须真的有 named section
# `config core 'main'`。UCI extended lookup 会造出匿名 `config main`，
# 那种文件 uci show 看着有东西，LuCI 按名字找 'main' 仍然找不到 → 427。
# 修复方式用 heredoc 直接写文件，绝不用 `uci set luci.main=...` 去"建段"
# （那正是造匿名段的元凶）。

PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
export PATH
CFG=/etc/config/luci

say() { echo "[luci-fix] $*"; logger -t luci-fix "$*" 2>/dev/null || true; }

# 主题目录探测：mediaurlbase 是 URL 路径，磁盘上对应 /www/luci-static/<主题>。
# argon 没装就回落 bootstrap，避免 mediaurlbase 指向空气（那会白屏但不是 427）。
THEME=/luci-static/argon
[ -d "/www$THEME" ] || THEME=/luci-static/bootstrap

have_named_main() {
    [ -s "$CFG" ] || return 1
    grep -qE "^[[:space:]]*config[[:space:]]+core[[:space:]]+('main'|\"main\")" "$CFG" 2>/dev/null
}

if have_named_main; then
    say "OK：已存在 named section core 'main'，无需重建"
else
    say "坏文件/缺段：重建 /etc/config/luci（这是 dispatcher.lua:427 的根因）"
    rm -f "$CFG" "$CFG.opkg" 2>/dev/null || true
    mkdir -p /etc/config 2>/dev/null || true
    cat > "$CFG" <<EOF
# rebuilt by /usr/sbin/luci-fix —— 必须保留 named section core 'main'
config core 'main'
	option lang 'zh_cn'
	option mediaurlbase '$THEME'
	option resourcebase '/luci-static/resources'

config internal 'sauth'
	option sessionpath '/var/run/luci'
	option sessiontime '3600'

config internal 'themes'
	option Argon '/luci-static/argon'
	option Bootstrap '/luci-static/bootstrap'
EOF
    chmod 644 "$CFG" 2>/dev/null || true
    # 校验收尾：写完后必须能按名字读到，否则明确报错而不是假装成功
    if have_named_main; then
        say "重建成功：$(grep -c '^config ' "$CFG") 个 section，主题 $THEME"
    else
        say "ERROR：重建后仍缺 named main，请检查 /etc/config 是否可写"
        exit 1
    fi
fi

# 主题指向不存在的目录时修正（named section 已存在，此时 uci set 安全）
if command -v uci >/dev/null 2>&1; then
    cur=$(uci -q get luci.main.mediaurlbase 2>/dev/null || echo '')
    if [ -n "$cur" ] && [ ! -d "/www${cur}" ] && [ ! -d "$cur" ]; then
        uci -q set luci.main.mediaurlbase="$THEME" 2>/dev/null || true
        uci commit luci 2>/dev/null || true
        say "mediaurlbase 从 '$cur' 修正为 '$THEME'"
    fi
fi

# 清掉 LuCI 的 Lua 索引缓存，避免旧的错误状态被缓存住
rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null || true
say "完成：浏览器刷新 /cgi-bin/luci 即可（账号 root / admin）"
exit 0
