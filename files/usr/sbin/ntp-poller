#!/bin/sh
# ntp-poller —— 固定周期 NTP 客户端 · 第 51 次
#
# 干什么：按【固定间隔】循环向内网 NTP 服务器校时，出厂 **每 5 分钟（300 秒）一次**。
#         开机立即同步一次 → 成功后 sleep 300 → 再同步 → 无限循环。
#         失败时 30 秒快速重试，恢复成功后自动回到 300 秒周期。
#
# 为什么不用 sysntpd 常驻：OpenWrt 的 sysntpd 跑的是 busybox ntpd，轮询间隔是
#   编译期常量 + 自适应（32s 起步、稳定后拉长到几十分钟），**没有 UCI 参数能钉成 5 分钟**，
#   也不接受「重新查询」信号。要严格「5 分钟循环」只能自己按周期触发一次性校时：
#     ntpd -q -n -p <server>     # -q = 设完时钟就退出
#   本脚本就是那个周期触发器；sysntpd 常驻同时停用，避免两个进程一起改时间打架。
#   不启用 cron（保持干净系统 / 低资源），一个 sh 循环 + sleep，几乎不占 CPU/内存。
#
# ★ 单调时钟：状态/倒计时全部用 /proc/uptime，不用 date。
#   NTP 每次校时都会改 wall clock，用它算「距下次同步」会瞬间乱跳。
#   机器狗 bridge-watchdog 同样用单调时钟，所以 NTP 跳变不会造成误重启。
#
# 数据源：仍是 /etc/config/system 的 system.ntp（两个内网源不变），本脚本只读，
#   不额外引入第三方包 / 插件。配置改完 restart 即生效，不用重编。
#
# 用法：
#   ntp-poller status              看周期 / 上次同步 / 成功失败次数 / 距下次还剩多久
#   ntp-poller once                立刻同步一次（绝不循环、绝不常驻）
#   ntp-poller set-minutes 5       ★改周期：N 分钟（1~1440），默认 5
#   ntp-poller set-interval 300    ★直接按秒改（30~86400）
#   ntp-poller set-retry 30        失败重试间隔秒（5~3600）
#   ntp-poller set-timeout 12      单源等待上限秒（3~60）
#   ntp-poller on | off            启用 / 停用
#   ntp-poller loop                内部使用，由 init.d 调，别手敲

CONF=system.ntp
STATE=/tmp/ntp-poller.state
LOG=/tmp/ntp-poller.log
LASTGOOD=/tmp/ntp-poller.lastgood

_uci() { uci -q get "$1" 2>/dev/null; }
_now() { awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0; }

# ── 配置（缺省值本身就能跑：配置丢了也是 5 分钟循环）─────────────
load_cfg() {
    ENABLED=$(_uci "$CONF.enabled");        [ -n "$ENABLED" ]  || ENABLED=1
    INTERVAL=$(_uci "$CONF.poll_interval"); [ -n "$INTERVAL" ] || INTERVAL=300
    RETRY=$(_uci "$CONF.retry_interval");   [ -n "$RETRY" ]    || RETRY=30
    TIMEOUT=$(_uci "$CONF.sync_timeout");   [ -n "$TIMEOUT" ]  || TIMEOUT=12
    case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=300 ;; esac
    case "$RETRY"    in ''|*[!0-9]*) RETRY=30 ;; esac
    case "$TIMEOUT"  in ''|*[!0-9]*) TIMEOUT=12 ;; esac
    [ "$INTERVAL" -ge 30 ]   2>/dev/null || INTERVAL=300
    [ "$INTERVAL" -le 86400 ] 2>/dev/null || INTERVAL=86400
    [ "$RETRY" -ge 5 ]       2>/dev/null || RETRY=30
    [ "$RETRY" -le 3600 ]    2>/dev/null || RETRY=3600
    [ "$TIMEOUT" -ge 3 ]     2>/dev/null || TIMEOUT=12
    [ "$TIMEOUT" -le 60 ]    2>/dev/null || TIMEOUT=60
    [ "$ENABLED" = 1 ] || ENABLED=0
    SERVERS=$(_uci "$CONF.server")
    # 配置被清空时的兜底：仍是用户指定的两个内网源，绝不塞公网 NTP
    [ -n "$SERVERS" ] || SERVERS='192.168.1.254
172.10.10.254'
}

# ── 源排序：上次成功的 > 与本机同网段的 > 其余（去重）────────────
# 192.168.1.254 在 /22 网段外、纯二层桥无默认网关时不可达；
# 把 172.10.10.254 排前面，开机第一次就能秒同步，不用白等 12 秒超时。
_ordered_servers() {
    my3=$(_uci network.lan.ipaddr)
    my3=${my3%.*}
    {
        [ -s "$LASTGOOD" ] && cat "$LASTGOOD"
        printf '%s\n' "$SERVERS" | while read -r s; do
            [ -n "$s" ] || continue
            [ "${s%.*}" = "$my3" ] && echo "$s"
        done
        printf '%s\n' "$SERVERS"
    } | awk 'NF && !seen[$0]++'
}

# ── 日志（简洁：成功每小时一条、失败每 6 轮一条，文件上限 120 行）──
_log() {
    logger -t ntp-poller "$*" 2>/dev/null || true
    printf '%s %s\n' "$(date '+%H:%M:%S' 2>/dev/null)" "$*" >> "$LOG"
    wd_n=$(wc -l < "$LOG" 2>/dev/null || echo 0)
    [ "$wd_n" -gt 120 ] 2>/dev/null && { tail -n 60 "$LOG" > "$LOG.tmp"; mv "$LOG.tmp" "$LOG"; }
    :
}
_state() {
    v=$(sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -1)
    case "$1" in
        ok_uptime|ok_count|fail_count)
            case "$v" in ''|*[!0-9]*) echo 0 ;; *) echo "$v" ;; esac ;;
        *) echo "${v:--}" ;;
    esac
}
_save_state() {  # $1=result $2=server $3=uptime $4=okcount $5=failcount
    {
        echo "last_result=$1"
        echo "last_server=$2"
        echo "ok_uptime=$3"
        echo "ok_count=$4"
        echo "fail_count=$5"
        echo "wall=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
    } > "$STATE.tmp" 2>/dev/null && mv "$STATE.tmp" "$STATE" 2>/dev/null || true
}

# ── 单源一次性校时（带超时；busybox 无 timeout 时用后台+轮询兜底）──
_try_server() {
    wd_s=$1
    if command -v timeout >/dev/null 2>&1; then
        timeout "$TIMEOUT" ntpd -q -n -p "$wd_s" >/dev/null 2>&1
        return $?
    fi
    ntpd -q -n -p "$wd_s" >/dev/null 2>&1 &
    wd_pid=$!
    wd_i=0
    while [ "$wd_i" -lt "$TIMEOUT" ]; do
        kill -0 "$wd_pid" 2>/dev/null || { wait "$wd_pid" 2>/dev/null; return $?; }
        sleep 1
        wd_i=$(( wd_i + 1 ))
    done
    kill "$wd_pid" 2>/dev/null || true
    wait "$wd_pid" 2>/dev/null || true
    return 1
}

# ── 一轮同步：任一源成功即算成功（一个不通自动用另一个）─────────
_sync() {
    wd_good=''
    for wd_s in $(_ordered_servers); do
        if _try_server "$wd_s"; then wd_good=$wd_s; break; fi
    done
    wd_now=$(_now)
    if [ -n "$wd_good" ]; then
        echo "$wd_good" > "$LASTGOOD" 2>/dev/null || true
        _save_state ok "$wd_good" "$wd_now" "$(( $(_state ok_count) + 1 ))" "$(_state fail_count)"
        return 0
    fi
    _save_state fail '-' "$(_state ok_uptime)" "$(_state ok_count)" "$(( $(_state fail_count) + 1 ))"
    return 1
}

# ── 常驻循环（由 init.d 调）：成功 → sleep INTERVAL；失败 → sleep RETRY ──
loop() {
    load_cfg
    [ "$ENABLED" = 1 ] || { _log "system.ntp.enabled=0，周期校时不启动"; exit 0; }
    _log "NTP 周期校时启动：每 ${INTERVAL}s（$(( INTERVAL / 60 )) 分钟）循环一次；失败 ${RETRY}s 重试；超时 ${TIMEOUT}s；源=$(printf '%s' "$SERVERS" | tr '\n' ' ')"
    while :; do
        if _sync; then
            wd_oc=$(_state ok_count)
            if [ "$wd_oc" -le 1 ] || [ $(( wd_oc % 12 )) -eq 0 ]; then
                _log "同步成功 #$wd_oc 源=$(_state last_server) 周期=${INTERVAL}s"
            fi
            sleep "$INTERVAL"
        else
            wd_fc=$(_state fail_count)
            [ $(( wd_fc % 6 )) -eq 1 ] && \
                _log "两个 NTP 源本轮都不可达（失败 $wd_fc 次），${RETRY}s 后重试；不影响网络" || true
            sleep "$RETRY"
        fi
    done
}

# ── 单次检测 / 状态 ──────────────────────────────────────────────
once() {
    load_cfg
    echo "NTP 单次校时：源=$(printf '%s' "$SERVERS" | tr '\n' ' ')  超时=${TIMEOUT}s"
    if _sync; then
        echo "结果：成功 源=$(_state last_server)  当前时间 $(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)"
        return 0
    fi
    echo '结果：两个源都不可达（不改动系统时间）；网络不受影响'
    return 1
}
status() {
    load_cfg
    now=$(_now)
    ok_u=$(_state ok_uptime)
    left=$(( ok_u + INTERVAL - now ))
    [ "$left" -lt 0 ] 2>/dev/null && left=0
    echo '========== ntp-poller 状态 =========='
    echo "  启用        : $ENABLED   (on / off)"
    echo "  ★同步周期   : $INTERVAL 秒 = $(( INTERVAL / 60 )) 分钟（成功后循环一次，无限重复）"
    echo "  失败重试    : $RETRY 秒（恢复后自动回到 $(( INTERVAL / 60 )) 分钟周期）"
    echo "  单源超时    : $TIMEOUT 秒"
    echo "  内网源      : $(printf '%s' "$SERVERS" | tr '\n' ' ')"
    echo "  当前生效源  : $(cat "$LASTGOOD" 2>/dev/null || echo '尚未成功')"
    echo "  仅客户端    : enable_server=0 / use_dhcp=0（不对外服务、不收 DHCP 下发的源）"
    echo "  成功 / 失败 : $(_state ok_count) / $(_state fail_count) 次"
    echo "  上次成功    : $(_state wall)（单调 uptime ${ok_u}s）"
    echo "  距下次同步  : ${left} 秒（单调时钟，不受 NTP 跳变影响）"
    echo "  当前时间    : $(date '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null)"
    echo '  ---------- 最近日志 ----------'
    tail -n 5 "$LOG" 2>/dev/null || echo '  (暂无)'
    echo '===================================='
    echo '  改周期：ntp-poller set-minutes 5   （或 set-interval 300）'
}

# ── 配置 CLI（UCI 持久化，restart 即生效，不用重编）──────────────
_restart_if_running() {
    [ -x /etc/init.d/ntp-poller ] && /etc/init.d/ntp-poller restart >/dev/null 2>&1 || true
}
_set() {
    uci set "$CONF.$1=$2" 2>/dev/null
    uci commit system 2>/dev/null
    _restart_if_running
}
_num_or_die() {  # $1=value $2=min $3=max $4=label
    case "$1" in ''|*[!0-9]*) echo "用法错误：$4 需要 $2..$3 的整数"; exit 1 ;; esac
    [ "$1" -ge "$2" ] && [ "$1" -le "$3" ] || { echo "$4 范围是 $2..$3"; exit 1; }
}
usage() {
    cat <<'EOF'
ntp-poller —— 固定周期 NTP 客户端

  status                 看周期 / 上次同步 / 成功失败次数 / 距下次还剩多久
  once                   立刻校时一次（绝不循环、绝不常驻）
  set-minutes N          ★改周期：N 分钟（1~1440），默认 5 → 300 秒
  set-interval N         ★改周期：N 秒（30~86400），默认 300
  set-retry N            失败重试间隔秒（5~3600），默认 30
  set-timeout N          单源等待上限秒（3~60），默认 12
  on | off               启用 / 停用
  loop                   内部使用，由 init.d 调，别手敲

  出厂：每 5 分钟循环校时一次；开机立即先同步一次。
  成功后 sleep 300 → 再同步 → 无限循环；两个源都不可达时 30 秒重试，
  恢复后自动回到 5 分钟周期。不启用 cron，不装任何额外包。
  源仍是 192.168.1.254 / 172.10.10.254（/22 下后者直连可达）。
EOF
}
main() {
    cmd=${1:-status}
    case "$cmd" in
        loop)  loop ;;
        once)  once ;;
        status) status ;;
        set-minutes)
            _num_or_die "${2:-}" 1 1440 'set-minutes'
            _set poll_interval "$(( $2 * 60 ))"
            echo "已设：每 $2 分钟循环校时一次（$(( $2 * 60 )) 秒，立即生效）" ;;
        set-interval)
            _num_or_die "${2:-}" 30 86400 'set-interval'
            _set poll_interval "$2"
            echo "已设：每 $2 秒循环校时一次（$(( $2 / 60 )) 分钟，立即生效）" ;;
        set-retry)
            _num_or_die "${2:-}" 5 3600 'set-retry'
            _set retry_interval "$2"; echo "已设：失败后 $2 秒重试" ;;
        set-timeout)
            _num_or_die "${2:-}" 3 60 'set-timeout'
            _set sync_timeout "$2"; echo "已设：单源等待上限 $2 秒" ;;
        on)  _set enabled 1; echo '已启用 NTP 周期校时'; /etc/init.d/ntp-poller start >/dev/null 2>&1 || true ;;
        off) _set enabled 0; echo '已停用 NTP 周期校时（重启后也不会自启）'; /etc/init.d/ntp-poller stop >/dev/null 2>&1 || true ;;
        *) usage ;;
    esac
}
case "$(basename "$0")" in ntp-poller) main "$@" ;; esac
