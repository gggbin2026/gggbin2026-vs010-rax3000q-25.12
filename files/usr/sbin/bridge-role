#!/bin/sh
# bridge-role —— WDS 自动「一主一备」（2026-11-22 第 8 次校准）
#
#   bridge-role run      开机由 /etc/init.d/bridge-role 调用，按模式文件运行
#   bridge-role auto     设回自动并立即重跑一轮收敛
#   bridge-role ap|sta   手动钉死「主 / 备」（写 /etc/bridge_role_mode，重启仍生效）
#   bridge-role status   看当前角色 / 本机 MAC / 对端 / 管理 IP / DHCP / 5G 频宽
#
# 自动判定（确定性收敛，不依赖谁先开机、不依赖 MAC 奇偶运气）：
#   1. 等 ath11k 双射频校准完成、无线接口起来（最多 180 秒）
#   2. 扫 SSID=WDS_AP 的 BSSID，排除自己
#   3. 本机 5G MAC 比对端 BSSID 大 -> 退让成 sta；否则 ap；扫不到 -> ap
#   4. 最多 3 轮（间隔 30 秒）重复判定，连续两轮相同即稳定退出；
#      只有角色变化才重应用 + 后台 wifi up，不会反复断链
#   => 必然收敛成「MAC 小的一台 = ap 主(.241/DHCP 1h)，MAC 大的一台 = sta 备(.242/DHCP 关)」
#   两台刷完不用手动改 IP、不用手动切角色。
#   扫描不可用 / 无线一直没就绪时，回退按本机 MAC 最后一字节奇偶（偶 ap / 奇 sta）。

. /usr/lib/bridge/role.sh

MODE_FILE=/etc/bridge_role_mode
ROLE_FILE=/etc/bridge_role          # role.sh 写：当前实际角色（ap / sta）

log() { logger -t bridge-role "$*" 2>/dev/null || true; echo "  $*"; }

my_mac() {
    # 5G 通常是 phy1；两台同型号索引一致，保证比较口径相同
    for p in /sys/class/ieee80211/phy1/macaddress \
             /sys/class/ieee80211/phy0/macaddress; do
        [ -r "$p" ] && { tr -d '\n' < "$p"; echo; return 0; }
    done
    cat /sys/class/net/br-lan/address 2>/dev/null
}

radio_ready() {
    iw dev 2>/dev/null | grep -q 'Interface' || return 1
    [ -n "$(my_mac)" ] || return 1
    return 0
}

wait_radio() {
    local i=0
    while [ "$i" -lt 60 ]; do
        radio_ready && return 0
        sleep 3; i=$((i+1))
    done
    return 1
}

# 扫到对端 WDS_AP 的 BSSID（排除自己），找不到返回 1
peer_bssid() {
    local me ifc b
    me=$(my_mac)
    for ifc in $(iw dev 2>/dev/null | awk '/^[[:space:]]*Interface/{print $2}'); do
        b=$(iw dev "$ifc" scan 2>/dev/null | awk -v me="$me" '
            /^BSS / { b=$2; sub(/\(.*/, "", b) }
            /SSID: WDS_AP/ { if (b != "" && tolower(b) != tolower(me)) { print b; exit } }
        ')
        [ -n "$b" ] && { echo "$b"; return 0; }
    done
    return 1
}

# MAC 是定长 17 字符小写十六进制，字典序 == 数值序；用 sort 判定谁大，
# 不依赖 busybox test 的 \> 扩展。
decide() {
    local me peer bigger
    me=$(my_mac); peer=$(peer_bssid)
    [ -z "$peer" ] && { echo ap; return 0; }        # 没看到对端 -> 自己当主
    bigger=$(printf '%s\n%s\n' "$me" "$peer" | sort | tail -n1)
    if [ "$bigger" = "$me" ] && [ "$me" != "$peer" ]; then
        echo sta                                     # 本机 MAC 大 -> 退让成备
    else
        echo ap
    fi
}

# 扫描彻底不可用时的兜底：按本机 MAC 最后一字节奇偶
fallback_role() {
    local h n
    h=$(my_mac | awk -F: '{print $6}')
    n=$(printf '%d' "0x$h" 2>/dev/null || echo 0)
    [ $((n % 2)) -eq 0 ] && echo ap || echo sta
}

apply_role() {
    local role="$1" cur
    cur=$(cat "$ROLE_FILE" 2>/dev/null)
    [ "$cur" = "$role" ] && return 0                 # 已是该角色，别重复 wifi up
    bridge_apply_role "$role" || { log "应用角色 $role 失败"; return 1; }
    ( /sbin/wifi up 2>/dev/null || wifi up 2>/dev/null || true ) &
    if [ "$role" = ap ]; then
        log "角色 -> ap（主：172.10.10.241 / DHCP 开 / 租期 1h）"
    else
        log "角色 -> sta（备：管理 IP 统一 172.10.10.241 / DHCP 关）"
    fi
}

run_mode() {
    local mode prev role i
    mode=$(cat "$MODE_FILE" 2>/dev/null || echo auto)
    case "$mode" in
      ap|sta)
        log "手动模式 $mode，跳过自动判定"
        apply_role "$mode"; return 0 ;;
      *) ;;
    esac

    if ! wait_radio; then
        log "无线 180 秒未就绪 -> 按 MAC 奇偶兜底"
        apply_role "$(fallback_role)"; return 0
    fi

    prev=''
    for i in 1 2 3; do
        role=$(decide)
        log "第 $i 轮判定：$role（本机 $(my_mac)，对端 $(peer_bssid 2>/dev/null || echo 未发现)）"
        apply_role "$role"
        [ "$role" = "$prev" ] && { log "角色已稳定：$role"; break; }
        prev="$role"
        [ "$i" -lt 3 ] && sleep 30
    done
}

status() {
    echo "模式        : $(cat "$MODE_FILE" 2>/dev/null || echo auto)（auto / ap / sta）"
    echo "当前角色    : $(cat "$ROLE_FILE" 2>/dev/null || echo 未应用)"
    echo "本机 5G MAC : $(my_mac)"
    echo "对端 BSSID  : $(peer_bssid 2>/dev/null || echo 未发现)"
    echo "管理 IP     : $(uci -q get network.lan.ipaddr 2>/dev/null)"
    echo "DHCP        : ignore=$(uci -q get dhcp.lan.ignore 2>/dev/null) / 租期 $(uci -q get dhcp.lan.leasetime 2>/dev/null)"
    echo "5G          : ch $(uci -q get wireless.radio1.channel 2>/dev/null) / $(uci -q get wireless.radio1.htmode 2>/dev/null) / mode $(uci -q get wireless.default_radio1.mode 2>/dev/null)"
    [ -s /etc/bridge_info ] && { echo "--- /etc/bridge_info ---"; cat /etc/bridge_info; }
}

case "${1:-status}" in
  run)    run_mode ;;
  auto)   echo auto > "$MODE_FILE"; run_mode ;;
  ap|sta) echo "$1" > "$MODE_FILE"; apply_role "$1" ;;
  status) status ;;
  *) echo "用法: bridge-role run|auto|ap|sta|status"; exit 1 ;;
esac
