// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * VS010 (中国联通 CUCC) Device Tree Source —— 新内核 6.12 融合版 · 第 44 次校正
 *
 * 骨架：qosmio/openwrt-ipq @ 25.12-nss 的 ipq5018-pz-l8.dts
 *       （只借 6.12 主线 ath11k/DSA 绑定：&wifi/&wifi1、
 *        qcom,ath11k-calibration-variant、QCA8337 ports 写法）
 *       ——【不】继承它的 GPIO / LED / 端口 label。
 *
 * 硬件真值（第 44 次）：用户上传的 docs/oem-dts/vs010.dtb（45056 B，
 *   DTB v17，原厂闭源固件运行态 /sys/firmware/fdt 导出）逐节点解析：
 *     model="CUCC VS010"  compatible="cucc,vs010" "qcom,ipq5018-ap-mp02.1" ...
 *     按键：仅 wps = GPIO34 / KEY_WPS_BUTTON(0x211) / debounce 60 ——【无 reset 键】
 *     LED ：mesh = GPIO33 低有效；pwr = GPIO31 低有效（默认 on）
 *     NAND：4bit/512（F5D01G41LB ESMT 系）
 *     dp1/dp2 local-mac = 58:99:a8:13:18:1b / 58:95:d8:13:28:2a
 *     0:ART @0x780000(1MiB)、0:TRAINING @0x880000、rootfs @0x900000
 *
 * 来源纠正：本仓库 fork 自 xiangye277/vs010-openwrt，而核查报告
 *   （docs/oem-dts/VS010与CMCC机型DTS资料核查报告.md 第三/五章）明确记录
 *   该版「GPIO 与 switch port 配置不正确」，作者本人在 issue #1 已否定。
 *   因此 GPIO/LED/ECC 一律以上面这份实机 FDT 为准，不再引用该版。
 *
 * 仍待实机核对的两处（本次【故意不改】，见 docs/板级真值-第44次.md）：
 *   1) QCA8337 端口排序：PZ-L8 是 PHY3=WAN；VS010 原厂 FDT 的
 *      switch_wan_bmp=0 / switch_lan_bmp=0x1e（四个口全 LAN），maxdarksol 版
 *      把直连 CPU 的 LAN3 对调成 WAN。maxdarksol 全文未取到，改错会网口全灭；
 *      由于 WAN+LAN 全在 br-lan，label 错位不影响桥接，刷后逐个试口即可。
 *   2) 5G bdf-addr：原厂 FDT 是 0x4d300000，主线 PZ-L8 骨架是 0x4d100000，
 *      属 5.4 闭源 cnss2 与 6.12 主线 ath11k 两套内存布局差异，禁止照抄。
 *
 * 不要用老仓库 vs010/ipq5018-vs010.dts（QSDK 5.4 wifi0/wifi1 写法）覆盖本文件。
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Unicom VS010";
	compatible = "unicom,vs010", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		led-boot = &led_pwr;
		led-failsafe = &led_mesh;
		led-running = &led_pwr;
		led-upgrade = &led_mesh;
		label-mac-device = <&dp1>;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	/*
	 * 按老仓库 NWRT /sys/firmware/fdt 实机真值修正（第 22 次校准）：
	 * VS010 实物只有 WPS 键 = GPIO34 / KEY_WPS_BUTTON(0x211)，没有 reset 键。
	 * 原 6.12 稿误把 GPIO33 配成 KEY_RESTART（实机 GPIO33 是 mesh 指示灯），会被常判按下，
	 * preinit 据此进 FAILSAFE（无 IP / 无无线 / 进不了 WEB）。整段删除复位键。
	 */
	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		wps-button {
			label = "wps";
			gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
			linux,code = <0x211>;   /* KEY_WPS_BUTTON，写数值避免旧 input.h 缺宏 */
			debounce-interval = <60>;
		};
	};

	/* vs010.dtb 实机 /soc/leds：mesh(GPIO33) + pwr(GPIO31)，均低有效。
	 * 旧版沿用 PZ-L8 的 WAN 绿灯 GPIO35，与本机不符，第 44 次已替换。 */
	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_mesh: led-0 {
			label = "mesh";
			gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led_pwr: led-1 {
			label = "pwr";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		/* vs010.dtb 实机 /soc/qpic-nand@79b0000/nandcs@0：4bit/512。
		 * F5D01G41LB(ESMT 系) 物理参数，与 RAX3000Q 的 8bit/512 不同。 */
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					// VS010 MAC layout: raw bytes at ART+0
					// eth0: D8:3D:CC:72:D5:43 @ offset 0x00
					// eth1: D8:3D:CC:72:D5:42 @ offset 0x06
					// vs010.dtb 实机 dp1/dp2 local-mac 作交叉：
					//   58:99:a8:13:18:1b / 58:95:d8:13:28:2a
					// 仍按 ART 0x0/0x6 取（第 39 次 ART 实证），不写死本机值
					macaddr_eth0: macaddr@0 {
						reg = <0x0 0x6>;
					};

					macaddr_eth1: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};
		};
	};
};

&switch {
	status = "okay";

	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		// MAC0 -> GE Phy --- MDI --- QCA8337 Phy4(Port5)
		port@1 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		// MAC1 -> Uniphy --- SGMII --- QCA8337 SerDes(Port6)
		port@2 {
			port_id = <2>;
			mdiobus = <&mdio1>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
};

// MAC0 -> GE Phy
&dp1 {
	status = "okay";

	nvmem-cells = <&macaddr_eth0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 -> SGMII
&dp2 {
	status = "okay";

	nvmem-cells = <&macaddr_eth1>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

// MAC0 -> GE Phy -> QCA8337 Phy4
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	/*
	 * 第 44 次「待实机核对」：以下 label 沿用 PZ-L8（PHY3=WAN，
	 * PHY0/1/2=LAN3/2/1），而 VS010 原厂 FDT 是 switch_lan_bmp=0x1e
	 * （四口全 LAN）、switch_wan_bmp=0，maxdarksol 版把直连 CPU 的 LAN3
	 * 对调成 WAN。maxdarksol 全文未取到，改错会网口全灭 → 本次不改。
	 * 由于 WAN+LAN+2.4G+5G 都在 br-lan（哑 AP），label 错位不影响桥接，
	 * 刷后上级线插哪个口不通就逐个换；要彻底对齐请按
	 * docs/板级真值-第44次.md 上机取证后再改这一段。
	 */
	// QCA8337 Phy0 -> LAN3
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN2
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> LAN1
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> WAN
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 Phy4 -> IPQ5018 GE Phy
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	// QCA8337 switch
	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				phy-mode = "sgmii";
				ethernet = <&dp2>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "lan3";
				phy-handle = <&qca8337_0>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			port@3 {
				reg = <3>;
				label = "lan1";
				phy-handle = <&qca8337_2>;
			};

			port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;
			};

			port@5 {
				reg = <5>;
				phy-handle = <&qca8337_4>;
				phy-mode = "gmii";
				ethernet = <&dp1>;
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		/* VS010 实机 WPS 键 = GPIO34；gpio33 悬空，绝不能配置成按键 */
		button-pins {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-state {
		/* mesh GPIO33 + pwr GPIO31（vs010.dtb 实机；旧 gpio35 是 PZ-L8 的 WAN 灯） */
		pins = "gpio33", "gpio31";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};

	switch_reset_pins: switch-reset-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

&q6v5_wcss {
	status = "okay";
};

&wifi {
	// IPQ5018 2.4G
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "Unicom-VS010";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;

	ieee80211-freq-limit = <2400000 2483000>;

	status = "okay";
};

&wifi1 {
	// QCN6102 5G
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "Unicom-VS010";
	qcom,ath11k-fw-memory-mode = <1>;
	/* vs010.dtb 原厂 FDT 的 5G bdf-addr 是 0x4d300000；这里保留主线
	 * PZ-L8 骨架的 0x4d100000（6.12 ath11k 内存布局），禁止照抄闭源值 */
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;

	ieee80211-freq-limit = <5150000 5730000>;

	status = "okay";
};
