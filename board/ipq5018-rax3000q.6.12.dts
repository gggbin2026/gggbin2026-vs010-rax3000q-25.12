/*
 * CMCC RAX3000Q / QY —— 6.12 主线 ath11k 板级（第 43 次新增，第 44 次按官方 DTS 校正）
 *
 * 骨架：qosmio/openwrt-ipq @ 25.12-nss 的 ipq5018-pz-l8.dts
 *       （只借 6.12 主线 ath11k/DSA 绑定：&wifi/&wifi1、
 *        qcom,ath11k-calibration-variant、QCA8337 `ports` 写法）
 *
 * ★ 第 44 次真值来源（用户上传 + 官方原文交叉核对）：
 *   A) docs/oem-dts/ipq5018-rax3000q.MAIN.dts
 *      —— openwrt/openwrt main 分支逐字节官方原文（6208 B，2026-09-27 合入
 *         "qualcommax: ipq50xx: add support for CMCC RAX3000Q/QY"）。
 *        实测 v25.12.6 稳定 tag 的 ipq50xx.mk 里【没有】RAX3000Q，
 *        qosmio 25.12-nss 整树也 0 命中，故本仓仍需注入板级。
 *   B) docs/oem-dts/ipq5018-rax3000q.dts —— 用户上传的网页还原稿（字段对照用）
 *   C) 第 41 次解包的 QSDK 12.2 好固件 FIT /images/fdt@1：
 *        model="CMCC RAX3000QY"  compatible="cmcc,rax3000qy" ...
 *        wifi board_id 0x24(2G)/0x60(5G)；caldb-addr=0
 *
 * 官方主线 DTS 的硬件真值（A，逐行核对）：
 *   model="CMCC RAX3000Q"  compatible="cmcc,rax3000q", "qcom,ipq5018"
 *   reset=GPIO23 低有效 / mesh-WPS=GPIO38 低有效
 *   LED 红24 / 绿19 / 蓝17（高有效）；QCA8337 复位 GPIO26
 *   闪存 GigaDevice GD5F1GQ5REYIG → 8bit/512（东芯 Dosilicon 变体不支持）
 *   QCA8337 reg 0x11(=17)：PHY0=WAN、PHY1=LAN1、PHY3=LAN2、PHY4=LAN3，
 *     port@0 = CPU(gmac1/SGMII)，gmac0/GE PHY 不参与
 *   ART 0x0=WAN / 0x6=LAN；原厂值为全 FF 时回退随机生成
 *   calibration-variant = "CMCC-RAX3000Q"
 *   因 256MiB 内存，官方把 q6v5_wcss / wifi / wifi1 全 disabled 防 OOM
 *
 * ⚠ 本文件【未在 6.12 主线实机验证】，三处刻意与官方不同：
 *   1) 【不定义 keys / leds】。恩山 2026-04-25 变砖实录：VS010 刷入 RAX3000Q
 *      的 U-Boot + 大分区后，因复位键 GPIO 不一致被持续采样为「按下」，
 *      循环重启、TTL 失联、最终需编程器。按键/LED 在两套栈里不等价，
 *      且不是哑 AP 的必要功能 → 宁可不定义，绝不猜 GPIO。
 *   2) 【WiFi 必须开】。官方 disabled 是怕 256M OOM，但 AP/网桥没无线就没意义。
 *      本仓已配 256M 低内存 profile；若 LuCI 操作仍 OOM，社区做法是
 *      ath11k-smallbuffers + zram（报告建议，未在 VS010/RAX3000Q 实测）。
 *   3) 【不抄 boot-args】。官方 main 的 &q6v5_wcss 用
 *      boot-args = <0x2 4 2 27 0 0>（PCIE1 / PD id 2）让 QCN6102 落 UPD ID 2；
 *      用户还原稿误写成 <0x02000000>。qosmio 25.12-nss 整树无任何 boot-args
 *      用法（绑定不同），抄进去会被忽略甚至报错 → 只在文档记录，
 *      若实机 5G 报 "expect it to be on UPD ID 3" 再按本树绑定另找方案。
 *
 * 绑定差异（重要）：官方 main 用 `qcom,calibration-variant` + `ethernet-ports`；
 *   qosmio 25.12-nss 用 `qcom,ath11k-calibration-variant` + `ports`。
 *   本文件按【目标树】写，不能整份照抄官方 DTS。
 *
 * ART 头是全 FF（见 art/art-truth.conf），DTS【不引用 nvmem macaddr】，
 * MAC 请按机身标签用 uci 固化；art-check 会提示。WAN+LAN 全在 br-lan。
 *
 * 首次刷机务必接 3.3V USB-TTL；若双频/网口异常，先用 device=vs010 单编验证。
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "CMCC RAX3000Q";
	/* 两个 compatible 都写：官方主线是 cmcc,rax3000q，
	 * 用户手上 QSDK 12.2 好固件 FDT 是 cmcc,rax3000qy（QY 变体），
	 * 末项 qcom,ipq5018 供通用匹配；02_network 两个分支都已注入。 */
	compatible = "cmcc,rax3000q", "cmcc,rax3000qy", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		/* 官方 3000Q 只用 gmac1(=本树 &dp2) 单链路，gmac0/GE PHY 不参与 */
		label-mac-device = <&dp2>;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		/* 官方 main DTS 实证：GigaDevice GD5F1GQ5REYIG → 8bit/512。
		 * 注意与 VS010 的 4bit/512 不同（两台闪存型号不同，按机型分别修）。
		 * 若板子是东芯 Dosilicon 变体、dmesg 报 unknown flash / EUCLEAN，
		 * 删掉这两行重编，让驱动自行协商。 */
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					hw_mac_addr: mac-address@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

/*
 * 以下 ESS / dp1 / ge_phy / mdio0 骨架沿用 PZ-L8，目的是【保证 qosmio 25.12-nss
 * 树能编译】（ipq5018-ess.dtsi 的 &switch.port_phyinfo 依赖 mdio0 的 phy_address 7）。
 * 官方 3000Q 实际上只启用 gmac1(=&dp2) 单条 SGMII 链路、gmac0/GE PHY 不参与，
 * 所以 QCA8337 的 CPU 口只有上面的 port@0，port@5 不再挂 &dp1。
 * 若实机 dmesg 出现 mdio0 / GE PHY 探针异常，再考虑把 &dp1 / &ge_phy /
 * &mdio0 的 status 改成 disabled（属板级调优，不影响本仓最稳默认值）。
 */
&switch {
	status = "okay";

	switch_mac_mode = <MAC_MODE_SGMII_CHANNEL0>;

	qcom,port_phyinfo {
		// MAC0 -> GE Phy --- MDI --- QCA8337 Phy4(Port5)
		port@0 {
			port_id = <1>;
			mdiobus = <&mdio0>;
			phy_address = <7>;
		};

		// MAC1 -> Uniphy --- SGMII --- QCA8337 SerDes(Port6)
		port@1 {
			port_id = <2>;
			mdiobus = <&mdio1>;
			forced-speed = <1000>;
			forced-duplex = <1>;
		};
	};
};

// MAC0 -> GE Phy
&dp1 {
	status = "okay";
};

// MAC1 -> SGMII
&dp2 {
	status = "okay";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

// MAC0 -> GE Phy -> QCA8337 Phy4
&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	/* 官方 RAX3000Q 映射（第 44 次校正；旧版抄 PZ-L8 的 PHY3=WAN 是错的） */
	// QCA8337 Phy0 -> WAN
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN1
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> 未使用（官方 3000Q 只有 4 个物理口）
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> LAN2
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 Phy4 -> LAN3（官方 3000Q：不接 GE PHY / gmac0）
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	// QCA8337 switch
	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* 官方 main ipq5018-rax3000q.dts 的端口映射，按本树 `ports` 绑定改写
		 * （官方写的是 `ethernet-ports` / `ethernet = <&gmac1>`，本树是
		 *  `ports` / `ethernet = <&dp2>`，数值一致：reg 0x11 = 十进制 17）。
		 * 与 PZ-L8 的关键差异：WAN 是 PHY0 而非 PHY3；只启用单条 SGMII
		 * CPU 链路（port@0），gmac0/GE PHY 不作为 CPU 口。 */
		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* port@0 = CPU 口（gmac1 / SGMII / 1000M 固定链路） */
			port@0 {
				reg = <0>;
				phy-mode = "sgmii";
				ethernet = <&dp2>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "wan";
				phy-handle = <&qca8337_0>;
			};

			port@2 {
				reg = <2>;
				label = "lan1";
				phy-handle = <&qca8337_1>;
			};

			port@4 {
				reg = <4>;
				label = "lan2";
				phy-handle = <&qca8337_3>;
			};

			port@5 {
				reg = <5>;
				label = "lan3";
				phy-handle = <&qca8337_4>;
			};
		};
	};
};

&tlmm {

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};

	switch_reset_pins: switch-reset-state {
		pins = "gpio26";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

/* 官方 main 用 boot-args=<0x2 4 2 27 0 0> 指定 QCN6102 落 UPD ID 2；
 * 本树（qosmio 25.12-nss）没有任何 boot-args 用法，绑定不同 → 不抄。
 * 若实机 5G 报 UPD ID 3，见 docs/板级真值-第44次.md 的排查项。 */
&q6v5_wcss {
	status = "okay";
};

&wifi {
	// IPQ5018
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-calibration-variant = "CMCC-RAX3000Q";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;

	ieee80211-freq-limit = <2400000 2483000>;

	status = "okay";
};

&wifi1 {
	// QCN6102 5G
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "CMCC-RAX3000Q";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;

	ieee80211-freq-limit = <5150000 5730000>;

	status = "okay";
};
