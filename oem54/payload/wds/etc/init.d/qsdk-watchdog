#!/bin/sh /etc/rc.common
# 第 44 次 · WDS 无线看门狗（机器狗）· procd 服务
# enabled=0 时连实例都不起，off 是彻底停用。
USE_PROCD=1
START=95
STOP=10
start_service() {
    [ "$(uci -q get wdsdog.main.enabled 2>/dev/null)" = "1" ] || return 0
    [ -x /usr/sbin/qsdk-watchdog ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/qsdk-watchdog loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger "wdsdog"; }
reload_service() { restart; }
