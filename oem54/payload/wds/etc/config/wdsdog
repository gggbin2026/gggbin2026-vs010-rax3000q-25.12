# 第 53 次 · WDS 机器狗默认配置（官方 5.4.213 闭源栈）
# 连续不通 5 分钟自动重启；自定义：qsdk-watchdog set-delay N（0~120 分钟）
# peer=auto：从 WDS 链路对端 MAC 反查 IP，自动排除本机地址，查不到退回关联判据。
# 改管理 IP 会重置计时并重新发现对端，不会误重启。
# 刷机 / TTL 调试前：qsdk-watchdog off
config wdsdog 'main'
	option enabled '1'
	option delay '5'
	option grace '6'
	option interval '30'
	option iface 'auto'
	option peer 'auto'
	option dryrun '0'
