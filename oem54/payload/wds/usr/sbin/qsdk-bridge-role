#!/bin/sh
# ───────────────────────────────────────────────────────────────────────
# qsdk-bridge-role · 第 44 次 · WDS 自动「一主一备」（官方 5.4.213 闭源栈适配）
#
#   run      开机由 init.d 后台调用：等无线就绪 → 判 ap/sta → 连续两轮稳定
#   status   看当前角色 / 本机 5G MAC / 对端 / 机器狗判据
#   ap|sta   手动钉死主/备（写 /etc/qsdk_role_mode，重启仍生效）
#   auto     恢复自动判定并立即重跑
#
# ★ 与老仓 bridge-role 的关键差异（为了保住官方满血无线）：
#   官方 QSDK12.2 用 qca-hostapd / lib/wifi/qcawifi.sh 那套配置体系，
#   与老仓 21.02 的 wifi-iface 语法不同。本脚本【绝不重建 wireless / network】，
#   只做只读探测 + 角色状态 + 机器狗 peer 提示。官方无线配置原样保留 = 满血。
#
#   收敛规则（确定性、不依赖谁先开机）：
#     扫到 WDS_AP 对端 → 本机 5G MAC 比对端 BSSID，小者 ap / 大者 sta
#     扫不到           → 按本机 MAC 末字节奇偶（偶 ap / 奇 sta），两台必错开
# ───────────────────────────────────────────────────────────────────────
. /usr/lib/oem54/qsdk-wifi.sh 2>/dev/null || true

MODE_FILE=/etc/qsdk_role_mode
ROLE_FILE=/etc/qsdk_role
PEER_FILE=/etc/qsdk_role_peer
STATE=/tmp/qsdk-role.json
LOG=/tmp/qsdk-bridge-role.log
SSID_MATCH='WDS_AP'
say(){ echo "  $*"; logger -t qsdk-bridge-role "$*" 2>/dev/null || true; }

radio_ready(){
    IF5=$(qwifi_5g 2>/dev/null)
    [ -n "$IF5" ] && [ -d "/sys/class/net/$IF5" ] || return 1
    MYMAC=$(qwifi_mac "$IF5" 2>/dev/null)
    [ -n "$MYMAC" ] || return 1
    return 0
}

wait_radio(){
    i=0
    while [ "$i" -lt 60 ]; do
        radio_ready && { say "无线就绪 5G=$IF5 MAC=$MYMAC"; return 0; }
        sleep 3; i=$((i+1))
    done
    say '等无线 180 秒仍未就绪，按 MAC 奇偶兜底判定'
    IF5=$(qwifi_5g 2>/dev/null); MYMAC=$(qwifi_mac "$IF5" 2>/dev/null)
    [ -z "$MYMAC" ] && MYMAC=$(cat /sys/class/net/br-lan/address 2>/dev/null)
    return 0
}

# 找对端 BSSID：iw scan → wlanconfig list scan → 空
find_peer(){
    P=''
    if command -v iw >/dev/null 2>&1 && [ -n "$IF5" ]; then
        P=$(iw dev "$IF5" scan 2>/dev/null \
            | awk -v s="$SSID_MATCH" '
                /^BSS /{bss=$2}
                /SSID:/{ if(index($0,s)>0 && bss!="") print bss }' \
            | grep -vi "^$(echo "$MYMAC" | tr 'a-f' 'A-F')$" | head -1)
    fi
    if [ -z "$P" ] && command -v wlanconfig >/dev/null 2>&1 && [ -n "$IF5" ]; then
        P=$(wlanconfig "$IF5" list scan 2>/dev/null \
            | grep -i "$SSID_MATCH" | awk '{print $1}' | head -1)
    fi
    echo "$P"
}

mac_last_hex(){ echo "$1" | awk -F: '{print toupper($NF)}'; }
cmp_mac(){  # 等长十六进制串字典序比较（sort 法，busybox ash 可靠）
    a=$(echo "$1" | tr -d ':' | tr 'a-f' 'A-F')
    b=$(echo "$2" | tr -d ':' | tr 'a-f' 'A-F')
    [ "$(printf '%s\n%s\n' "$a" "$b" | sort | tail -1)" = "$a" ] && echo greater || echo less
}

decide(){
    P=$(find_peer)
    if [ -n "$P" ] && [ "$P" != "$MYMAC" ]; then
        [ "$(cmp_mac "$MYMAC" "$P")" = greater ] && echo sta || echo ap
    else
        # 取 MAC 最后一个十六进制字符判奇偶（不依赖 printf 的 0x 转换）
        L=$(mac_last_hex "$MYMAC")
        LAST=${L#?}
        case "$LAST" in
            1|3|5|7|9|B|D|F|b|d|f) echo sta ;;
            *)                       echo ap ;;
        esac
    fi
    printf '%s' "$P" > "$PEER_FILE"
}

# 第 46 次：收敛后按角色做【安全 UCI 增量】的主备 IP / DHCP。
# 仍不重建 network/wireless 段、不覆盖官方配置，只改几个 option —— 保住满血无线。

# 【第 53 次】改管理 IP → 提示同步机器狗 peer，并把旧 peer 迁到 auto，避免误重启
_wd_ip_changed(){
    NEW=${1:-$(uci -q get network.lan.ipaddr 2>/dev/null)}
    P=$(uci -q get wdsdog.main.peer 2>/dev/null)
    say "⚠ 管理 IP 已改为 $NEW：机器狗循环会自动重置连续计时并重新发现对端，不会误重启"
    say "  若要互相 ping：qsdk-watchdog set-peer <对端新IP>；或用 set-peer auto 自动发现"
    say "  改 IP 前建议先 qsdk-watchdog off，改完再 on"
    if [ -n "$P" ] && [ "$P" != auto ]; then
        uci -q set wdsdog.main.peer='auto' 2>/dev/null
        uci -q commit wdsdog 2>/dev/null
        say "  ✓ 旧 peer '$P' 已自动改为 auto"
    fi
}

apply_role_network(){
    R=$1
    C=/etc/qsdk-firstboot.conf
    g(){ sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$C" 2>/dev/null | head -1; }
    if [ "$R" = sta ]; then IP=$(g WDS_STA_IP); [ -z "$IP" ] && IP=172.10.10.241; IGN=1
    else                     IP=$(g WDS_AP_IP);  [ -z "$IP" ] && IP=172.10.10.241; IGN=0; fi
    uci -q get network.lan >/dev/null 2>&1 || { say 'network.lan 不存在，跳过角色 IP'; return; }
    CUR=$(uci -q get network.lan.ipaddr 2>/dev/null)
    [ "$CUR" = "$IP" ] && { say "角色 IP 已是 $IP，无需改动"; return; }
    say "角色=$R → 管理 IP $CUR → $IP，本机 DHCP ignore=$IGN"
    uci -q set network.lan.proto='static'
    uci -q set network.lan.ipaddr="$IP"
    uci -q set network.lan.netmask='255.255.252.0'
    _wd_ip_changed "$IP"
    uci -q set network.lan.stp='1'
    uci -q set dhcp.lan.ignore="$IGN"
    uci -q set dhcp.lan.leasetime='1h'
    uci commit
    /etc/init.d/dnsmasq restart 2>/dev/null || true
    /etc/init.d/network restart 2>/dev/null || true
}

write_state(){
    R=$1; P=$(cat "$PEER_FILE" 2>/dev/null || echo '')
    printf '%s\n' "$R" > "$ROLE_FILE"
    printf '{"role":"%s","iface":"%s","mac":"%s","peer_bssid":"%s","kernel":"%s","stack":"qca-wifi-closed","mode_file":"%s"}\n' \
        "$R" "$IF5" "$MYMAC" "$P" "$(uname -r)" "$(cat "$MODE_FILE" 2>/dev/null || echo auto)" > "$STATE"
    # 安全 UCI 增量：只写角色标记，不动 network / wireless / dhcp
    uci -q set qsdk-guard.main.role="$R" 2>/dev/null && uci commit qsdk-guard 2>/dev/null || true
    say "角色=$R  iface=$IF5  mac=$MYMAC  peer=$P"
    apply_role_network "$R"
}

run(){
    [ -f "$MODE_FILE" ] || echo auto > "$MODE_FILE"
    M=$(cat "$MODE_FILE")
    wait_radio
    if [ "$M" = ap ] || [ "$M" = sta ]; then
        : > "$PEER_FILE"; write_state "$M"
        say "手动钉死模式=$M，跳过自动收敛"; return 0
    fi
    PREV=''; STABLE=0; R=''
    i=0
    while [ "$i" -lt 3 ]; do
        R=$(decide)
        [ "$R" = "$PREV" ] && STABLE=$((STABLE+1)) || STABLE=1
        PREV=$R
        say "第 $((i+1)) 轮判定：$R（连续 $STABLE 轮）"
        [ "$STABLE" -ge 2 ] && break
        sleep 20; i=$((i+1))
    done
    write_state "$R"
    say '自动收敛完成（官方无线配置未改动）'
}

status(){
    echo "========== WDS 自动一主一备 · QSDK 5.4.213 =========="
    printf '  内核 / 栈      : %s / 闭源 qca-wifi + NSS\n' "$(uname -r)"
    printf '  当前角色        : %s\n' "$(cat "$ROLE_FILE" 2>/dev/null || echo '未判定')"
    printf '  模式文件        : %s\n' "$(cat "$MODE_FILE" 2>/dev/null || echo auto)"
    IF5=$(qwifi_5g 2>/dev/null)
    printf '  5G 接口 / MAC   : %s / %s\n' "$IF5" "$(qwifi_mac "$IF5" 2>/dev/null || echo '-')"
    printf '  对端 BSSID      : %s\n' "$(cat "$PEER_FILE" 2>/dev/null || echo '-（用关联判通断）')"
    printf '  无线 VAP        : %s\n' "$(qwifi_all 2>/dev/null | tr '\n' ' ')"
    printf '  关联状态        : %s\n' "$(qwifi_assoc "$IF5" >/dev/null 2>&1 && echo 已关联 || echo 未关联)"
    printf '  机器狗          : %s\n' "$(uci -q get wdsdog.main.enabled 2>/dev/null || echo '-')"
    echo
    echo '  手动：qsdk-bridge-role ap|sta|auto|status   （改完立即生效、重启保留）'
    echo '  注：本脚本不重建官方 wireless / network 配置，保住满血无线。'
}

case "${1:-status}" in
    run)     run | tee -a "$LOG" ;;
    status)  status ;;
    ap|sta)  printf '%s\n' "$1" > "$MODE_FILE"; say "模式已设为 $1，重跑收敛"; run | tee -a "$LOG" ;;
    auto)    echo auto > "$MODE_FILE"; say '已恢复自动判定'; run | tee -a "$LOG" ;;
    *) echo "用法: qsdk-bridge-role run|status|ap|sta|auto"; exit 1 ;;
esac
exit 0
