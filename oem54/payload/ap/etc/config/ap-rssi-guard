# 第 44 次 · AP 弱信号剔除配置（与 qsdk-rssi-guard / CGI guard 面板同源）
# 低于 reject_dbm 的新关联拒绝；低于 kick_dbm 的已关联终端剔除。
# 守护本体是 /usr/sbin/qsdk-rssi-guard（构建期从 apply-full-config.sh 提取），
# 本文件只供 CGI 显示与现场调参，删了不影响守护运行。
config guard 'main'
	option enabled '1'
	option reject_dbm '-90'
	option kick_dbm '-92'
	option interval '3'
	option consecutive '3'
	option dryrun '0'
	option grace_sec '10'
