#!/bin/sh
# ───────────────────────────────────────────────────────────────────────
# qsdk-firstboot-config · 第 46 次 · 刷完即成型的业务配置（幂等 / 可回滚）
#
#   之前「绝不覆盖官方配置」的取舍，和用户「我不用动」的要求是冲突的：
#   实机刷完仍是官方 192.168.1.1、空 root 密码、官方 SSID、防火墙与一堆
#   多余服务全在。本脚本在【首启】用 uci 增量把它们改成约定状态，
#   不重建段、不整体覆盖 network/wireless、不删 NSS/无线依赖。
#
#   全部参数在 /etc/qsdk-firstboot.conf（KEY=VALUE），改那个文件即可，
#   不用改脚本、不用重编。默认值为历史约定。
#
#   qsdk-firstboot-config              应用（幂等）
#   qsdk-firstboot-config --dry-run    只打印将做什么
#   qsdk-firstboot-config --rollback   回滚 uci + shadow
#   qsdk-firstboot-config status       打印当前实际状态
#   qsdk-firstboot-config --force      忽略 done 标记重跑
#
#   ⚠ 应用时会 restart network（让新 IP 立即生效），当前 SSH 会断一下。
# ───────────────────────────────────────────────────────────────────────
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH; export PATH
CONF=/etc/qsdk-firstboot.conf
STAMP=/etc/qsdk-firstboot-config.done
BK=/etc/oem54-backup/firstboot-config
DRY=0; ROLL=0; STATUS=0; FORCE=0
for a in "$@"; do
  case "$a" in --dry-run) DRY=1;; --rollback) ROLL=1;; status) STATUS=1;; --force) FORCE=1;; esac
done
say(){ echo "[firstboot-config] $*"; logger -t qsdk-firstboot-config "$*" 2>/dev/null || true; }
cfg(){ v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null | head -1 | sed 's/[[:space:]]*#.*$//'); [ -n "$v" ] && { echo "$v"; return; }; echo "$2"; }

# ── 默认值（CONF 缺失时也能跑）──
SSID24=$(cfg WIFI_SSID_24 'BRIDGE-SETUP')
SSID5=$(cfg WIFI_SSID_5 'WDS_AP')
WKEY=$(cfg WIFI_KEY 'WDS123456')
PASSH=$(cfg ROOT_PASSWORD_HASH '$1$QsK9Wd$Kh.6Ulr/GvMk.eGLGzO340')
WDS_AP_IP=$(cfg WDS_AP_IP '172.10.10.241')
WDS_STA_IP=$(cfg WDS_STA_IP '172.10.10.241')
AP_IP=$(cfg AP_IP '172.10.10.241')
NETMASK=$(cfg NETMASK '255.255.252.0')
DO_FW=$(cfg DISABLE_FIREWALL 1)
DO_V6=$(cfg DISABLE_IPV6 1)
DO_SLIM=$(cfg SLIM_SERVICES 1)
DO_IP=$(cfg APPLY_ROLE_IP 1)
DO_NET=$(cfg APPLY_NET_CLEAN 1)
NTP1=$(cfg NTP_SERVER_1 '192.168.1.254')
NTP2=$(cfg NTP_SERVER_2 '172.10.10.254')
MODE=$(cat /etc/firmware_mode 2>/dev/null || echo wds)

# 官方多余服务黑名单（只 disable，不删包 —— 删包会破坏 NSS/无线依赖链）
SLIM_BL='autoreboot breakpad ddns ddns-go dhcrelay4 diag_socket_app firewall inetd
         lldpd macsec mcsd mia miniupnpd odhcpd pppoe-relay pppoe-server quagga
         relayd rstp ssid_steering wsplcd zerotier boot-ftm trymodedone'

# ── status ──
if [ "$STATUS" = 1 ]; then
  echo '========== 首启业务配置 · 当前实际状态 =========='
  printf '  固件构建      : %s\n' "$(cat /etc/firmware_build 2>/dev/null || echo '-')"
  printf '  模式          : %s\n' "$MODE"
  printf '  管理 IP       : %s\n' "$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | tr '\n' ' ')"
  printf '  root 密码     : %s\n' "$(awk -F: '/^root:/{print ($2==""?"空（未设置）":"已设置")}' /etc/shadow 2>/dev/null)"
  printf '  无线 SSID     : %s\n' "$(uci show wireless 2>/dev/null | grep '\.ssid=' | tr '\n' ' ')"
  printf '  防火墙服务    : %s\n' "$([ -x /etc/init.d/firewall ] && /etc/init.d/firewall enabled && echo enabled || echo disabled)"
  printf '  IPv6 br-lan   : %s\n' "$(cat /proc/sys/net/ipv6/conf/br-lan/disable_ipv6 2>/dev/null || echo '?')"
  printf '  DHCP 服务端   : %s\n' "$(case "$(uci -q get dhcp.lan.ignore 2>/dev/null)" in 1) echo 已关;; *) echo 开启;; esac)"
  printf '  配置文件      : %s\n' "$CONF"
  printf '  WAN / WAN6    : %s\n' "$(uci -q get network.wan 2>/dev/null || echo '已删除')"
  printf '  NTP 客户端    : %s\n' "$(uci -q get system.ntp.server 2>/dev/null | tr '\n' ' ')"
  printf '  STP           : %s\n' "$(uci -q get network.lan.stp 2>/dev/null || echo '?')"
  printf '  sysntpd       : %s\n' "$([ -x /etc/init.d/sysntpd ] && /etc/init.d/sysntpd enabled && echo enabled || echo disabled)"
  echo '  回滚：qsdk-firstboot-config --rollback'
  exit 0
fi

# ── rollback ──
if [ "$ROLL" = 1 ]; then
  say '回滚 uci / shadow / sysctl'
  [ -f "$BK/uci.tar.gz" ] && tar xzf "$BK/uci.tar.gz" -C / 2>/dev/null && say '  ✓ uci 已还原'
  [ -f "$BK/shadow" ] && cp "$BK/shadow" /etc/shadow && say '  ✓ shadow 已还原'
  rm -f "$STAMP" /etc/sysctl.d/99-qsdk-no-ipv6.conf
  uci commit 2>/dev/null || true
  say '回滚完成，重启后完全回到官方配置：reboot'
  exit 0
fi

BID=$(cat /etc/firmware_build 2>/dev/null || echo unknown)
[ -f "$STAMP" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$BID" ] && [ "$FORCE" = 0 ] \
  && { say "本构建 $BID 已应用过（用 --force 重跑）"; exit 0; }

RUN(){ if [ "$DRY" = 1 ]; then echo "  [dry-run] $*"; else eval "$*"; fi }

if [ "$DRY" = 0 ]; then
  mkdir -p "$BK"
  # 备份将被改的 uci 与 shadow
  tar czf "$BK/uci.tar.gz" -C / etc/config/wireless etc/config/network etc/config/dhcp etc/config/firewall etc/config/system 2>/dev/null || true
  [ -f /etc/shadow ] && cp /etc/shadow "$BK/shadow"
fi

say "模式=$MODE  2.4G=$SSID24  5G=$SSID5  密码=$WKEY  管理IP见下"

# ① root 密码（官方 root:: 是空密码，实机确认）
if [ -f /etc/shadow ]; then
  say '① 设置 root 密码为 admin（官方默认是空）'
  # ★ 不走 RUN/eval：MD5-crypt hash 里含 $1$salt$，eval 会把 $1/$salt 当变量
  #   二次展开成空，密码就会被写坏。这里直接 sed，只展开一次。
  if [ "$DRY" = 1 ]; then echo '  [dry-run] 写 /etc/shadow root 密码 hash'
  else sed -i "s|^root:[^:]*:|root:${PASSH}:|" /etc/shadow; fi
fi

# ② 无线 SSID / 密码：遍历所有 wifi-iface 段做 uci 增量，不重建段
#    QSDK12.2 实测用的就是标准 wifi-iface + ssid/key/encryption（见 lib/wifi/qcawifi.sh）
if uci -q show wireless >/dev/null 2>&1; then
  say '② 改写无线 SSID / 密码 / 清 disabled'
  # ★ 防呆：硬上限 16 + 连续 3 个空段即退出。
  #   任何 uci 实现异常（返回 0 但值为空）都不能让首启卡在死循环里。
  IDX=0; EMPTY=0
  while [ "$IDX" -lt 16 ] && uci -q get "wireless.@wifi-iface[$IDX]" >/dev/null 2>&1; do
    S="@wifi-iface[$IDX]"
    DEV=$(uci -q get "wireless.$S.device" 2>/dev/null)
    [ -z "$DEV" ] && EMPTY=$((EMPTY+1)) || EMPTY=0
    [ "$EMPTY" -ge 3 ] && { say '  连续空段，停止遍历（防呆）'; break; }
    CH=$(uci -q get "wireless.$DEV.channel" 2>/dev/null)
    BAND=$(uci -q get "wireless.$DEV.band" 2>/dev/null)
    HW=$(uci -q get "wireless.$DEV.hwmode" 2>/dev/null)
    case "$CH:$BAND:$HW" in
      *5a*|*11a*|*a:*|[3-9][6-9]:*|[1-9][0-9][0-9]:*) SS="$SSID5" ;;
      *) SS="$SSID24" ;;
    esac
    # AP 模式两个射频都用统一 SSID（不做 WDS 配对）
    [ "$MODE" = ap ] && SS="$SSID24"
    say "   $S (device=$DEV channel=$CH) → $SS"
    RUN "uci -q set wireless.\"$S\".ssid='$SS'"
    RUN "uci -q set wireless.\"$S\".key='$WKEY'"
    RUN "uci -q set wireless.\"$S\".encryption='psk2'"
    RUN "uci -q set wireless.\"$S\".disabled='0'"
    IDX=$((IDX+1))
  done
  # 也清 wifi-device 的 disabled
  for r in radio0 radio1 radio2 wifi0 wifi1; do
    uci -q get "wireless.$r" >/dev/null 2>&1 && RUN "uci -q set wireless.$r.disabled='0'"
  done
  [ "$IDX" = 0 ] && say '  ::warning::未找到 wifi-iface 段（board.d 可能还没生成，稍后自动重试）'
  RUN 'uci commit wireless'
else
  say '② ::warning::/etc/config/wireless 尚不存在，跳过'
fi

# ③ 防火墙：纯二层桥不需要 netfilter，关服务但保留包（NSS/ECM 依赖 conntrack 模块，不是 firewall 服务）
if [ "$DO_FW" = 1 ] && [ -x /etc/init.d/firewall ]; then
  say '③ 关闭 firewall 服务（保留包，避免破坏依赖）'
  RUN '/etc/init.d/firewall stop 2>/dev/null || true'
  RUN '/etc/init.d/firewall disable 2>/dev/null || true'
fi

# ④ 多余服务：只 disable 明确黑名单，绝不动 NSS/无线/管理链
if [ "$DO_SLIM" = 1 ]; then
  say '④ 关闭多余服务（黑名单，不删包）'
  for s in $SLIM_BL; do
    [ -x "/etc/init.d/$s" ] || continue
    RUN "/etc/init.d/$s stop 2>/dev/null || true"
    RUN "/etc/init.d/$s disable 2>/dev/null || true"
  done
  # 第 50 次：TTYD 用户点名保留，显式 enable（官方 rootfs 自带 init.d/ttyd）
  [ -x /etc/init.d/ttyd ] && RUN '/etc/init.d/ttyd enable 2>/dev/null || true'
  say '   要真正卸载包：qsdk-slim --dry-run 先看，再 --remove'
fi

# ⑤ IPv6 关闭（实机 br-lan 有 fdb2:.../60）
if [ "$DO_V6" = 1 ]; then
  say '⑤ 关闭 IPv6（RA / DHCPv6 / br-lan）'
  RUN "uci -q set network.lan.ipv6='0'"
  RUN "uci -q set dhcp.lan.ra='disabled'"
  RUN "uci -q set dhcp.lan.dhcpv6='disabled'"
  RUN "uci -q set dhcp.lan.ndp='disabled'"
  RUN "printf 'net.ipv6.conf.br-lan.disable_ipv6=1\nnet.ipv6.conf.default.disable_ipv6=1\n' > /etc/sysctl.d/99-qsdk-no-ipv6.conf"
  RUN 'sysctl -p /etc/sysctl.d/99-qsdk-no-ipv6.conf >/dev/null 2>&1 || true'
fi

# ⑥ 管理 IP / 本机 DHCP：只改 option，不重建段
#    ★ 更正：官方是【静态 192.168.1.1/22】，不是上级 DHCP 分配。
#      第 43~45 次 WDS 分支写的 lan.proto=dhcp 在实机没生效且会丢管理地址，已删除。
if [ "$DO_IP" = 1 ] && uci -q get network.lan >/dev/null 2>&1; then
  if [ "$MODE" = ap ]; then
    IP=$AP_IP; IGN=1
  else
    ROLE=$(cat /etc/qsdk_role 2>/dev/null || echo ap)
    [ "$ROLE" = sta ] && { IP=$WDS_STA_IP; IGN=1; } || { IP=$WDS_AP_IP; IGN=0; }
  fi
  say "⑥ 管理 IP → $IP / $NETMASK，本机 DHCP ignore=$IGN"
  RUN "uci -q set network.lan.proto='static'"
  RUN "uci -q set network.lan.ipaddr='$IP'"
  RUN "uci -q set network.lan.netmask='$NETMASK'"
  # 【第 53 次】改管理 IP 的红色提醒（下载页也有）：机器狗不会因此误重启
  say '⚠ 管理 IP 已改：机器狗循环会自动重置连续计时并重新发现对端，不会误重启'
  say '  若要互相 ping：qsdk-watchdog set-peer <对端新IP>；或 set-peer auto 自动发现'
  say '  默认 peer=auto（自动发现对端）；改 IP 前建议先 qsdk-watchdog off，改完再 on'
  RUN "uci -q set network.lan.gateway=''"
  RUN "uci -q set network.lan.dns=''"
  RUN "uci -q set network.lan.stp='1'"
  RUN "uci -q set dhcp.lan.ignore='$IGN'"
  RUN "uci -q set dhcp.lan.leasetime='1h'"
  RUN "uci -q set dhcp.lan.start='100'"
  RUN "uci -q set dhcp.lan.limit='100'"
  RUN 'uci commit'
  # AP 模式加链路本地别名，上级网段不是 172.10.8.0/22 也能直连管理页
  [ "$MODE" = ap ] && RUN "sysctl -w net.ipv4.conf.br-lan.promote_secondaries=1 >/dev/null 2>&1 || true"
else
  say '⑥ ::warning::network.lan 不存在，跳过 IP 增量'
fi

# ⑦【第 51 次】删除 WAN/WAN6 接口 + NTP 客户端只同步内网两台 + 确认 STP
#   官方固件自带 wan/wan6 与公网 NTP；纯二层桥不需要 WAN，也不对外提供时间服务。
#   用 uci 增量删除，不重建段、不动物理口、不碰 NSS/无线依赖链。
if [ "$DO_NET" = 1 ]; then
  say "⑦ 清除 wan/wan6；NTP 客户端 → $NTP1 / $NTP2；STP=1"
  for S in network.wan network.wan6 dhcp.wan dhcp.wan6; do
    [ -n "$(uci -q show "$S" 2>/dev/null)" ] && RUN "uci -q delete $S"
  done
  RUN "uci -q set network.lan.stp='1'"
  RUN "uci -q set system.ntp.enabled='1'"
  RUN "uci -q set system.ntp.enable_server='0'"
  RUN 'uci -q delete system.ntp.server'
  RUN "uci -q add_list system.ntp.server='$NTP1'"
  RUN "uci -q add_list system.ntp.server='$NTP2'"
  RUN 'uci commit'
  RUN '/etc/init.d/sysntpd enable 2>/dev/null || true'
  RUN '/etc/init.d/sysntpd restart 2>/dev/null || true'
fi

# ⑧ 让改动立即生效
if [ "$DRY" = 0 ]; then
  say '⑧ 重启 network / dnsmasq / wifi，使配置立即生效'
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  # 【第 53 次】机器狗与 NTP 定时同步开机自启
  /etc/init.d/qsdk-watchdog enable 2>/dev/null || true
  /etc/init.d/qsdk-watchdog restart 2>/dev/null || true
  /etc/init.d/ntp-sync enable 2>/dev/null || true
  /etc/init.d/ntp-sync restart 2>/dev/null || true
  /etc/init.d/network restart 2>/dev/null || true
  ( sleep 8; wifi reload 2>/dev/null || wifi up 2>/dev/null || true ) &
  printf '%s\n' "$BID" > "$STAMP"
  say '完成。新管理 IP 见上面 ⑥；SSH/页面请改用新地址。'
  say "备份在 $BK，回滚：qsdk-firstboot-config --rollback"
else
  echo '  ── 以上为 dry-run，未改动任何文件 ──'
fi
exit 0
