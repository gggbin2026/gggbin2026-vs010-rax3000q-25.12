#!/bin/sh
# ───────────────────────────────────────────────────────────────────────
# qsdk-nic-guard · 第 44 次 · 网口 / 服务链兜底（官方 5.4.213 栈专用安全版）
#
# 与老仓 files/usr/sbin/nic-guard 的区别（重要）：
#   ✗ 不删 /etc/config/firewall      —— 官方 NSS/ECM 依赖它
#   ✗ 不 ip addr add 固定管理 IP     —— 官方 firstboot 已把 lan 设成 DHCP 客户端
#   ✗ 不 /etc/init.d/network restart —— 会断网
#   ✓ 只做「桥存在 / 网口在桥里 / 关键服务 enable / 无线未起时补一次 wifi up」
#
# 手动：qsdk-nic-guard        （只读检查 + 幂等兜底，随时可跑）
# ───────────────────────────────────────────────────────────────────────
. /usr/lib/oem54/qsdk-wifi.sh 2>/dev/null || true
LOG=/tmp/qsdk-nic-guard.log
say(){ echo "[nic-guard] $*"; logger -t qsdk-nic-guard "$*" 2>/dev/null || true; }

{
  echo "================ qsdk-nic-guard $(date) ================"
  echo "kernel : $(uname -r)"
  echo "--- ip link ---"; ip link 2>&1
  echo "--- 无线接口 ---"; qwifi_all 2>/dev/null || ls /sys/class/net 2>/dev/null | grep -E '^(ath|wifi|wlan)'
  echo "--- br-lan ---";  brctl show 2>/dev/null || ip link show br-lan 2>/dev/null
} > "$LOG" 2>&1

# ① 桥：只在缺失时创建，绝不重建（官方 netifd 建的桥带完整参数）
if ! ip link show br-lan >/dev/null 2>&1; then
  say 'br-lan 缺失，补建（不动官方配置）'
  ip link add name br-lan type bridge 2>/dev/null || brctl addbr br-lan 2>/dev/null || true
  ip link set br-lan up 2>/dev/null || true
fi

# ② 网口：只把存在且尚未入桥的 ethX 挂进去
for e in eth0 eth1 eth2; do
  [ -d "/sys/class/net/$e" ] || continue
  ip link set "$e" up 2>/dev/null || true
  m=$(cat "/sys/class/net/$e/master" 2>/dev/null || echo '')
  [ -n "$m" ] && continue
  ip link set "$e" master br-lan 2>/dev/null || brctl addif br-lan "$e" 2>/dev/null || true
done

# ③ 关键服务：只 ensure enable，不 restart（避免打断官方首启流程）
for s in network uhttpd dropbear qsdk-guard qsdk-nic-guard; do
  [ -x "/etc/init.d/$s" ] && /etc/init.d/$s enable 2>/dev/null || true
done

# ④ 无线没起来补一次（后台，等 cnss2/QMI 校准完）
N=$(qwifi_all 2>/dev/null | wc -l)
if [ "$N" -eq 0 ]; then
  say '未发现无线 VAP，35 秒后补一次 wifi up'
  ( sleep 35; wifi up 2>/dev/null || true ) &
else
  say "无线 VAP $N 个：$(qwifi_all 2>/dev/null | tr '\n' ' ')"
fi

# ⑤ LuCI / SSH 自修（复用注入的兼容工具，绝不 uci set 建匿名段）
[ -x /usr/sbin/luci-fix ] && sh /usr/sbin/luci-fix >/dev/null 2>&1 || true
[ -x /usr/sbin/health-fix ] && sh /usr/sbin/health-fix >/dev/null 2>&1 || true

say "完成，详见 $LOG"
exit 0
