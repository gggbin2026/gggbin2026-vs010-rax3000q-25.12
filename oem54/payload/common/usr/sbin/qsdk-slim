#!/bin/sh
# ───────────────────────────────────────────────────────────────────────
# qsdk-slim · 第 46 次 · 可选卸载官方多余插件
#
#   首启默认只【关闭】多余服务（qsdk-firstboot-config ④），不删包 ——
#   官方 opkg 依赖链里 NSS / 无线 / LuCI 包互相牵连，盲删会变砖。
#   真要删，先看清单再删：
#
#   qsdk-slim                 列出可卸载包 + 依赖检查（不动系统）
#   qsdk-slim --remove        实际卸载（只删白名单，带 --force-depends 前的确认）
#   qsdk-slim --restore       重新 enable 首启被 disable 的多余服务
#
# ⚠ 卸载后不可回滚（除非重刷固件）。建议只做关闭，不做删除。
# ───────────────────────────────────────────────────────────────────────
PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH; export PATH
REMOVE=0; RESTORE=0
[ "${1:-}" = '--remove' ] && REMOVE=1
[ "${1:-}" = '--restore' ] && RESTORE=1

# 明确与桥接/WDS/AP 无关、且不被 NSS/无线依赖的 opkg 包
WHITE='ddns-scripts ddns-go lldpd miniupnpd zerotier quagga-ripd relayd
       pppoe-relay pppoe-server macsec mcsd mia wsplcd ssid-steering
       dhcrelay4 diag_socket_app breakpad autoreboot'

SLIM_BL='autoreboot breakpad ddns ddns-go dhcrelay4 diag_socket_app firewall inetd
         lldpd macsec mcsd mia miniupnpd odhcpd pppoe-relay pppoe-server quagga
         relayd rstp ssid_steering wsplcd zerotier boot-ftm trymodedone'

say(){ echo "[slim] $*"; logger -t qsdk-slim "$*" 2>/dev/null || true; }

if [ "$RESTORE" = 1 ]; then
  for s in $SLIM_BL; do
    [ -x "/etc/init.d/$s" ] && { /etc/init.d/$s enable 2>/dev/null || true
      /etc/init.d/$s start 2>/dev/null || true; say "已恢复 $s"; }
  done
  exit 0
fi

say '官方多余包白名单（只列实际已安装的）：'
FOUND=''
for p in $WHITE; do
  if opkg list-installed 2>/dev/null | grep -q "^$p "; then
    echo "  ✓ $p"
    FOUND="$FOUND $p"
  fi
done
[ -z "$FOUND" ] && { say '无可卸载包（或 opkg 数据库未就绪）'; exit 0; }

say ''
say '── 依赖检查：下列包被其它已安装包依赖，删了会连带破坏 ──'
for p in $FOUND; do
  dep=$(opkg whatdepends "$p" 2>/dev/null | grep -E '^\s+\S+ depends on' | head -3)
  [ -n "$dep" ] && echo "  ⚠ $p : $dep"
done

if [ "$REMOVE" = 0 ]; then
  say ''
  say '这是预览，未改动系统。确认无误后执行：qsdk-slim --remove'
  say '⚠ 建议只做「关闭服务」，不删包：首启已自动关闭，卸载属可选且不可回滚。'
  exit 0
fi

say '开始卸载（逐个，失败即跳过）'
for p in $FOUND; do
  if opkg remove "$p" >/tmp/qsdk-slim-rm.log 2>&1; then say "  ✓ 已卸载 $p"
  else say "  ✗ 跳过 $p（有依赖或失败）"; fi
done
say '完成。重启后生效；如 LuCI/无线异常，重刷固件即可恢复。'
exit 0
