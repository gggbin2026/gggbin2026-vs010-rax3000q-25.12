# ══════════════════════════════════════════════════════════════
# bridge-watchdog 插件 · 用户配置模板（第 58 次）
# 用法：cp /etc/wdsdog/wdsdog.conf.example /etc/wdsdog.conf，然后自己编辑。
# ★ /etc/wdsdog.conf 优先级【最高】，覆盖 /etc/config/wdsdog 同名项。
# ★ 全部注释 = 未配置 = 插件只待命、绝不重启（不会替你擅自决定）。
# ★ 改完 /etc/init.d/bridge-watchdog restart 生效，不用重编固件。
# ★ 删掉 /etc/wdsdog.conf 即回到 UCI 出厂配置。
# ══════════════════════════════════════════════════════════════
# enabled=1
# delay=5
# grace=6
# interval=30
# iface=auto
# peer=auto
# anchor=
# mode=or
# max_reboots=3
# dryrun=0
