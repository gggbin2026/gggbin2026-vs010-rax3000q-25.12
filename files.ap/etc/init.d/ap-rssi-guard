#!/bin/sh /etc/rc.common
# 【AP 模式】弱信号剔除守护 · procd 服务
# 由 99-bridge-ready 首启 enable+start；ap-rssi-guard on/off 控制。
USE_PROCD=1
START=96
STOP=10

start_service() {
    [ "$(uci -q get ap-rssi-guard.main.enabled 2>/dev/null)" = "1" ] || return 0
    [ -x /usr/sbin/ap-rssi-guard ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/ap-rssi-guard loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "ap-rssi-guard"
}

reload_service() { restart; }
