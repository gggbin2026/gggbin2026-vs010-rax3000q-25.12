# 【AP 模式】两个射频都是普通 AP，无 wds / 无 4addr / 无自动主备。
# SSID 故意与 WDS 版（WDS_AP / BRIDGE-SETUP）不同，开机一眼能分清刷的是哪套。
# OpenWrt 25.12 用 option band（2g/5g）；21.02 的 hwmode 已升级。
# 5G 仍 ch36 + HE160（36~64 共 160MHz 连续频谱）；驱动不支持自动回落 HE80。

config wifi-device 'radio0'
	option type 'mac80211'
	option band '2g'
	option channel '1'
	option htmode 'HE40'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'NwrtAP-2G'
	option encryption 'psk2+ccmp'
	option key 'admin12345'
	option disabled '0'
	# 第 29 次：hostapd 层拒绝弱信号关联（不支持则守护兜底）
	option rssi_reject_assoc_rssi '-90'
	option rssi_reject_assoc_timeout '5'
	# 第 29 次：hostapd 层拒绝弱信号关联；hostapd.sh 不认识该 option 时忽略，由 ap-rssi-guard 兜底
	option rssi_reject_assoc_rssi '-90'
	option rssi_reject_assoc_timeout '5'

config wifi-device 'radio1'
	option type 'mac80211'
	option band '5g'
	option channel '36'
	option htmode 'HE160'
	option country 'CN'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'NwrtAP-5G'
	option encryption 'psk2+ccmp'
	option key 'admin12345'
	option disabled '0'
