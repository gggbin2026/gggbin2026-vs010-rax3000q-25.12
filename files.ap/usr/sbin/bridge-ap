#!/bin/sh
# bridge-ap —— 普通 AP 模式的现场配置工具（第 20 次校准）
#
# 出厂是「哑 AP」：br-lan 固定 192.168.1.240/24，本机 DHCP 服务端关，
# 终端地址由上级路由分配。但上级路由如果不是 192.168.1.0/24 网段，
# .240 就够不着管理页 —— 这时用本工具切到 DHCP 客户端或改静态地址。
#
# 纯 UCI 操作，不碰无线 / 防火墙 / 机器狗，改完自动 restart network。
# 所有改动即时生效并落盘；串口逐行敲，别整段粘贴。

CONF=/etc/config/network
DHCP_CONF=/etc/config/dhcp

_need_uci() {
    command -v uci >/dev/null 2>&1 || {
        echo "错误：uci 不可用（这固件应该是 OpenWrt 21.02）" >&2; exit 1; }
}

_ip_ok() {
    v=$1
    case "$v" in ''|*[!0-9.]*) return 1 ;; esac
    OLDIFS=$IFS; IFS=.
    set -- $v
    IFS=$OLDIFS
    [ "$#" -eq 4 ] || return 1
    for o in "$1" "$2" "$3" "$4"; do
        case "$o" in ''|*[!0-9]*) return 1 ;; esac
        [ "$o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

_apply() {
    uci commit network
    [ -x /etc/init.d/network ] && /etc/init.d/network restart 2>/dev/null || true
    echo "已生效。稍等 5 秒后 ip -4 addr show br-lan 查看实际地址。"
}

_status() {
    echo "========== 普通 AP 模式 · 当前配置 =========="
    printf '固件模式      : %s\n' "$(cat /etc/firmware_mode 2>/dev/null || echo '未知（应为 ap）')"
    printf 'lan 协议      : %s\n' "$(uci -q get network.lan.proto 2>/dev/null || echo '-')"
    printf '静态管理地址  : %s\n' "$(uci -q get network.lan.ipaddr 2>/dev/null || echo '（无，DHCP 客户端模式）')"
    printf '本机 DHCP 端  : %s\n' "$(case "$(uci -q get dhcp.lan.ignore 2>/dev/null)" in 1) echo '已关（上级分配，哑 AP 默认）';; *) echo '开启';; esac)"
    printf 'br-lan 实际地址:\n'
    ip -4 addr show br-lan 2>/dev/null | grep -o 'inet [0-9./]*' | sed 's/^/                 /' || echo '                 （桥还没起来）'
    LL=$(ip -4 addr show br-lan 2>/dev/null | grep -oE '169\.254\.[0-9.]+' | head -1)
    printf '链路本地别名  : %s\n' "${LL:-未挂载（重启后由 bridge-netfix 自动加）}"
    printf '机器狗        : %s\n' "$(uci -q get wdsdog.main.enabled 2>/dev/null | grep -qx 0 && echo '停用（AP 默认）' || echo '启用')"
    echo "----------------------------------------------"
    echo "★ 没有 DHCP 也能连：PC 设 192.168.1.10/24 直连 LAN 口 → http://192.168.1.240"
    echo "                     或设 169.254.240.2/16 → http://169.254.240.1"
    echo "上级网段不是 192.168.1.0/24 → bridge-ap dhcp（自动取址）"
    echo "                              或 bridge-ap ip 192.168.50.2（改成同级静态）"
    echo "不接上级独立调试 → bridge-ap rescue（临时开本机 DHCP）"
    echo "调试完回哑 AP   → bridge-ap ap"
    echo "改回出厂        → bridge-ap ip 192.168.1.240"
    echo "=============================================="
}

usage() {
    cat <<'EOF'
bridge-ap —— 普通 AP 模式现场配置

  bridge-ap status                 查看当前协议 / 地址 / DHCP / 桥实际地址
  bridge-ap dhcp                   ★ 切成 DHCP 客户端：br-lan 从上级路由自动取址
                                   （上级不是 192.168.1.0/24 时用；去上级客户端列表找它）
  bridge-ap ip 192.168.50.2        改静态管理 IP 到上级同网段（自动设 /24）
  bridge-ap dhcp-server on|off     临时开/关本机 DHCP 服务端（默认 off；不接上级时可开）
  bridge-ap rescue                 ★ 临时进调试态：静态 .240 + 开本机 DHCP（不接上级时 PC 自动拿地址）
  bridge-ap ap                     ★ 回哑 AP 出厂态：静态 .240 + 关本机 DHCP
  bridge-ap static 192.168.1.240   回出厂静态地址（等价于 ip 192.168.1.240）

出厂默认：静态 192.168.1.240/24 + 本机 DHCP 关 + 网线插任意 LAN 口。
★ 本机 DHCP 关 ≠ 连不上：静态管理地址不依赖 DHCP，PC 手动设 192.168.1.10/24 即可直连；
  另外 br-lan 常挂 169.254.240.1/16，PC 设 169.254.240.2/16 也能连，任何上级网段都不冲突。
注意：bridge-ap dhcp 后静态 .240 会消失，请从上级路由的客户端列表找新地址。
EOF
}

_need_uci
[ -f "$CONF" ] || { echo "错误：缺 $CONF" >&2; exit 1; }

cmd=${1:-status}
case "$cmd" in
    status)
        _status
        ;;
    dhcp)
        uci -q set network.lan.proto='dhcp'
        uci -q delete network.lan.ipaddr
        uci -q delete network.lan.netmask
        uci -q delete network.lan.gateway
        uci -q delete network.lan.dns
        echo "已切到 DHCP 客户端：静态 192.168.1.240 会消失，请到上级路由客户端列表找新地址。"
        _apply
        ;;
    ip|static)
        a=${2:-}
        if [ "$cmd" = static ] && [ -z "$a" ]; then a=192.168.1.240; fi
        if ! _ip_ok "$a"; then
            echo "用法: bridge-ap ip <合法 IPv4>，例如 bridge-ap ip 192.168.50.2" >&2
            exit 1
        fi
        uci -q set network.lan.proto='static'
        uci -q set network.lan.ipaddr="$a"
        uci -q set network.lan.netmask='255.255.255.0'
        uci -q delete network.lan.gateway
        uci -q delete network.lan.dns
        echo "管理地址已设为 $a/24（请确认它和上级路由同网段且没被占用）。"
        _apply
        ;;
    dhcp-server)
        case "${2:-}" in
            on)  uci -q set dhcp.lan.ignore='0'; echo "本机 DHCP 服务端已开（注意别和上级路由双 DHCP）" ;;
            off) uci -q set dhcp.lan.ignore='1'; echo "本机 DHCP 服务端已关（哑 AP 默认）" ;;
            *)   echo "用法: bridge-ap dhcp-server on|off" >&2; exit 1 ;;
        esac
        uci commit dhcp
        [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart 2>/dev/null || true
        ;;
    rescue|ap)
        # 一次性把「地址 + 本机 DHCP」成对设好，避免用户开了 DHCP 却忘了改地址。
        uci -q set network.lan.proto='static'
        uci -q set network.lan.ipaddr='192.168.1.240'
        uci -q set network.lan.netmask='255.255.255.0'
        uci -q delete network.lan.gateway
        uci -q delete network.lan.dns
        if [ "$cmd" = 'rescue' ]; then
            uci -q set dhcp.lan.ignore='0'
            uci -q set dhcp.lan.start='100'
            uci -q set dhcp.lan.limit='100'
            uci -q set dhcp.lan.leasetime='1h'
            echo "调试态：管理地址 192.168.1.240 + 本机 DHCP 已开（PC 可自动拿到 192.168.1.100~199）"
            echo "⚠ 只在不接上级路由时这么用；接上级会双 DHCP。调试完记得 bridge-ap ap 还原。"
        else
            uci -q set dhcp.lan.ignore='1'
            echo "已回哑 AP 出厂态：192.168.1.240 静态 + 本机 DHCP 关（地址由上级分配）"
        fi
        uci commit dhcp
        _apply
        [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq restart 2>/dev/null || true
        ;;
    *)
        usage
        ;;
esac
