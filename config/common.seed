# 两模式共用差异配置 —— 2026-11-24 第二次修订：只编「必要」的
# 原则：最稳、最少系统问题。不编任何第三方 luci-app-* / 科学插件 / 下载工具。
# 保留：SSH(dropbear) + TTYD + LuCI 底座/中文/bootstrap 主题 + 状态页 + 无线/有线必要驱动。
# 由 scripts/gen-config.sh 读取，最终 make defconfig 收敛。

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
# 256MB 板必须开低内存 profile，否则 ath11k 起不来（无线满速前提）
# NSS 固件以 12.5 为优先（PZ-L8 自测相对 12.2 +65%；kuncy7 ipq50xx feed 亦默认 12.5）。
# 不在此写 CONFIG_NSS_FIRMWARE_VERSION_* 符号：三条基线的符号名/取值不同，
# 由基线自带 feed 决定；运行期由 /usr/sbin/wifi-fullspeed 报告实际版本。
CONFIG_ATH11K_MEM_PROFILE_256M=y
# VS010 / PZ-L8 同板：官方 25.12 的 Device/cmcc_pz-l8 没写 DEVICE_PACKAGES，
# 必须显式补 ath11k 固件（qcn6122 变体，不是 ipq5018 通用包，否则 2.4G 不 probe）
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
# VS010 本地 BDF 包（board-inject.sh 生成，不联网；无 board-2.bin 时为空包）
CONFIG_PACKAGE_ipq-wifi-cucc_vs010=y

# ── LuCI 底座 + 中文 + 官方主题（默认只 bootstrap，零第三方依赖）──
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
# argon / footstrap 是社区主题，不在官方 25.12 luci feed 里（见 themes.seed）。
# 写 =y 会被 make defconfig 静默丢掉，而 /etc/config/luci 若指向不存在的
# /luci-static/argon 就会白屏 / 主题页 500 —— 老仓库「进不去」的根因。
# 默认显式关闭；真要编请先加对应第三方 feed 并核对包名，再改成 =y。
CONFIG_PACKAGE_luci-theme-argon=n
CONFIG_PACKAGE_luci-theme-footstrap=n
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_uhttpd=y

# ── 必留：SSH + TTYD（用户明确要求）──
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ── 网络/无线必要 ──
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_bridge=y
CONFIG_PACKAGE_ethtool=y

# ── 无线端 DHCP 防护（独立 nft bridge 表，不装 firewall4）──
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# ── 明确关闭：防火墙 / 无用插件 / 旧栈 ──
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_luci-mod-dashboard is not set
# CONFIG_PACKAGE_luci-app-librespeed is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_luci-theme-material is not set
# CONFIG_PACKAGE_luci-theme-edge is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_https-dns-proxy is not set

# 注意：25.12 用 apk，不要再写 luci-lib-ipkg / luci-i18n-opkg-zh-cn / opkg
# 注意：不要写 CONFIG_IPV6=n —— 那是 QSDK 5.4 ECM BUG_ON 的规避，6.12 不需要
# 注意：不要写 CONFIG_ATH11K_NSS_SUPPORT / MAC80211_NSS_SUPPORT（5.4 私有符号）
# 注意：WAN + LAN 全部在 br-lan（port-overlay.sh 生成 list ports lan1/lan2/lan3/wan）
