# 精简包清单。gen-config.sh 会：
#   1) 过滤 feed 里不存在的 OPTIONAL 包（不是只打 warning）
#   2) 按 MODE / DEVICE / NSS 追加必要项
#   3) make defconfig 后复核 luci-app-* 只能有 1 个
# 说明：官方 25.12 用 apk，CONFIG_PACKAGE_* 写法不变。

# ── 底座（MUST，官方 feed 一定有）──
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_uci=y

# ── OPTIONAL（feed 里可能没有，gen-config.sh 逐个探测后删除）──
OPTIONAL:CONFIG_PACKAGE_luci-app-ttyd=y
OPTIONAL:CONFIG_PACKAGE_ttyd=y
OPTIONAL:CONFIG_PACKAGE_luci-compat=y
OPTIONAL:CONFIG_PACKAGE_luci-lib-base=y
OPTIONAL:CONFIG_PACKAGE_kmod-nft-bridge=y

# ── 显式关闭（稳定 / 低占用 / 纯二层）──
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-adblock is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_https-dns-proxy is not set
# CONFIG_PACKAGE_iperf3 is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_autocore is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-theme-footstrap is not set
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set

# IPv6：官方基线编译期关；NSS 基线保留内核符号，只关网络层（见 gen-config.sh）
# CONFIG_IPV6 is not set
