# ============================================================================
# 源码 / 内核基线 —— 本仓唯一真值。改这里，不要改 workflow。
# 变量命名：REPO_<ID> / REF_<ID> / KERNEL_HINT_<ID> / NSS_<ID> / BOARD_<ID>
# ID 里的 . 与 - 一律写成 _，全部大写。新增基线只需加一组变量 + 在 workflow
# 的 baseline choice 里加一个选项。
# ============================================================================
DEFAULT_BASELINE=official-25.12

# ① 官方稳定版（默认）= xiangye277/vs010-openwrt 同源 openwrt/openwrt，
#    但把「不带 -b 的滚动 main」锁成可复现 tag。内核 6.12.112，apk，无 NSS。
REPO_OFFICIAL_25_12=https://github.com/openwrt/openwrt.git
REF_OFFICIAL_25_12=v25.12.6
KERNEL_HINT_OFFICIAL_25_12=6.12.112
NSS_OFFICIAL_25_12=0
BOARD_OFFICIAL_25_12=inject

# ② 官方主线（xiangye277 原始口径）：仍不锁版本，强烈建议 Run workflow 时
#    在 source_ref 填具体 commit，否则每次编译可能得到不同内核。
REPO_OFFICIAL_MAIN=https://github.com/openwrt/openwrt.git
REF_OFFICIAL_MAIN=main
KERNEL_HINT_OFFICIAL_MAIN=unknown
NSS_OFFICIAL_MAIN=0
BOARD_OFFICIAL_MAIN=inject

# ③ qosmio NSS 稳定分支：6.12.116 + NSS FW 12.5，5G 160MHz 773~833Mbps。
#    r22：NSS 包名按 qosmio/nss-packages @ NSS-12.5-K6.x 实证修正，
#    gen-config.sh 在 defconfig 后硬校验 5 个包全进 .config，缺包直接停编，
#    不再「静默丢弃」编出假加速固件。默认仍是 ① 官方无 NSS（占用最低）。
#    上游仓库若改名/迁移，只改下面两行即可（不要改 workflow）。
REPO_QOSMIO_25_12_NSS=https://github.com/qosmio/openwrt-ipq.git
REF_QOSMIO_25_12_NSS=25.12-nss
KERNEL_HINT_QOSMIO_25_12_NSS=6.12.116
NSS_QOSMIO_25_12_NSS=1
BOARD_QOSMIO_25_12_NSS=inject

# ④ 6.18 尝鲜：不含这两台板级，board-inject.sh 会打警告；上游地址按你手上
#    实际仓库填 REPO_KUNCY7_6_18_NSS，留空则 workflow 直接拒绝该基线。
REPO_KUNCY7_6_18_NSS=
REF_KUNCY7_6_18_NSS=6.18-nss
KERNEL_HINT_KUNCY7_6_18_NSS=6.18.60
NSS_KUNCY7_6_18_NSS=1
BOARD_KUNCY7_6_18_NSS=warn

# 通用
ART_CALIBRATION=0          # 0=用官方通用 board-2.bin，1=实验性本机校准（需实机验证）
CALDATA_DEFAULT=off
NAND_PATCH_DEFAULT=0
KEEP_RELEASES=5
TZ=Asia/Shanghai
PRODUCT=WDS/AP（仿UBNT）
