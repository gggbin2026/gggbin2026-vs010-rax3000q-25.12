# 新内核基线定义（workflow 的 baseline 下拉会 source 本文件）
# 切换基线只改这里，不要改两份 yml。
#
# 固件名里的内核版本不取这里的预估值，而是编译期由
#   `make -s kernel_version` 实际抓取值写入文件名（见两份 workflow 的 Prepare 步）。
# 这里的 KERNEL_* 只作为抓取失败时的兜底与文档引用。
# 25.12/qosmio 的 DTS 目录是 target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/
# （不是旧版 target/linux/qualcommax/dts/），board-inject.sh 第 43 次已适配。

# ── A：推荐 · OpenWrt 25.12 + NSS（最稳 + RAX3000Q 实机验证）──────
BASE_A_NAME="qosmio-25.12-nss"
BASE_A_URL="https://github.com/qosmio/openwrt-ipq"
BASE_A_REF="25.12-nss"
BASE_A_KERNEL="6.12.116"          # 25.12 分支 + 后续安全补丁（6.12.91→6.12.113→6.12.116）
BASE_A_NSS="NSS FW 12.5（ECM→NSS 路由/双射频卸载；12.2 仅作回退）"
BASE_A_PKGMGR="apk"
# ★ 第 43 次实证更正（2026-11-24）：qosmio/openwrt-ipq @ 25.12-nss（d6848fa2）
#   整树 12317 个路径里 "rax3000q" 0 命中；image/ipq50xx.mk 只有 15 个官方
#   ipq50xx 设备（含 cmcc_pz-l8），【没有】cmcc_rax3000q。
# ★ 第 44 次补证：openwrt/openwrt 【main 分支】确实有逐字节官方原文
#   target/linux/qualcommax/dts/ipq5018-rax3000q.dts（2026-09-27 合入
#   "add support for CMCC RAX3000Q/QY"），但 v25.12.6 稳定 tag 的
#   ipq50xx.mk 仍无此设备 → 只进了 main，未回填 25.12 稳定分支。
#   所以基线 A/B 都要本仓注入板级；官方原文存于 docs/oem-dts/ 供逐行核对。
#   旧注释「树内原生、实机验证过」是错的。现在由 board-inject.sh 按同芯片
#   PZ-L8 骨架 + 好固件 FIT 真实 DTB 的 model/compatible 注入（未在 6.12 实机验证）。
BASE_A_RAX3000Q="inject:pz-l8-skeleton"  # 注入板级，见 board/ipq5018-rax3000q.6.12.dts
BASE_A_VS010="inject"                     # 用 board-inject.sh 注入
BASE_A_WIFI="5G ch36/HE160/2SS 实机上/下行 773/695 Mbps，峰值 833 Mbps，HE-MCS11 2401.9Mbps 协商"

# ── B：官方稳定 · 最可复现（无 NSS，无线满速不要选这个）──────────
BASE_B_NAME="official-25.12.6"
BASE_B_URL="https://github.com/openwrt/openwrt"
BASE_B_REF="v25.12.6"             # 锁 tag，不跟分支漂移
BASE_B_KERNEL="6.12.112"
BASE_B_NSS="none（官方主线不含 NSS；DSA 走 Linux 转发约 502M 就跑满双核，无线走 host CPU）"
BASE_B_PKGMGR="apk"
BASE_B_RAX3000Q="inject"          # 官方 25.12 的 15 个 ipq50xx 设备里没有 RAX3000Q
BASE_B_VS010="inject"
BASE_B_WIFI="无硬件加速；仅作为编译排错/主题最多时的退路"

# ── C：更高内核 SNAPSHOT（需自己移植两台板级）────────────────────
BASE_C_NAME="kuncy7-6.18-nss"
BASE_C_URL="https://github.com/kuncy7/openwrt-nss-edma"
BASE_C_REF="c3po-tag-8021q"
BASE_C_KERNEL="6.18.60"           # 2026-11-07 社区满血 WiFi 版同步 6.18.60，修 WiFi↔WAN 降速 + CVE-2026-98432
BASE_C_NSS="NSS FW 12.5 优先 + WLAN.HK.2.7.0.1；12.2-156 仅作回退。5G 160MHz AP→STA 915 Mbps、CPU 1~3%（AX55 实测）"
BASE_C_PKGMGR="apk"
BASE_C_RAX3000Q="missing"         # 未覆盖，需要自己移植板级
BASE_C_VS010="missing"
BASE_C_WIFI="wifi_offload=1 时 600Mbps@16% 单核；=0 时 500Mbps@90% 双核（AX6000 实测）"

DEFAULT_BASELINE="qosmio-25.12-nss"

# ── 参考实现（不参与 workflow 下拉，仅作为「无线加速正确做法」的移植来源）──
# mufeng05/openwrt-cmcc-pz-l8-nss：未修改的官方 25.12.5 基线 + 高通官方 QSDK 14.0
# 驱动源码（不是厂商 SDK 分支），qca-ssdk/swconfig 取代 DSA，两个独立 GMAC
# (eth0/eth1) 各自 CPU 口；有线 + 两个射频全部在 NSS 核内转发，包不进 Linux。
# 它是 PZ-L8 单板 overlay 仓库，不含 VS010 / RAX3000Q 板级，所以**不设为可编译基线**；
# 可移植的做法已逐条落到本仓运行期文件与配置里。
REF_PZL8_URL="https://github.com/mufeng05/openwrt-cmcc-pz-l8-nss"
REF_PZL8_KERNEL="6.12.94"
REF_PZL8_BASELINE="OpenWrt 25.12.5 未修改基线 / aarch64"
REF_PZL8_DRIVER="QSDK 14.0 官方源码（qca-nss-drv / ECM / wifili）"
REF_PZL8_NSS_FW="12.5（相对 12.2 自测 +65%）"
REF_PZL8_WIRED="949 / 949 Mbps @ +0 % 主机 CPU"
REF_PZL8_WIFI_5G="160 MHz 697 Mbps（四路 HTTP）/ 80 MHz 462 Mbps；主机 CPU 2.9 %"
REF_PZL8_WIFI_2G="20 MHz 75 Mbps / 40 MHz noscan 112.5 Mbps（唯一落后项，受邻区丢包影响）"
REF_PZL8_TOPOLOGY="qca-ssdk + swconfig（非 DSA）；被加速流量不经过 Linux 网桥"
REF_PZL8_STATUS="CPU 温度取 thermal type 含 cpu；射频温度取 ath11k_hwmon，按设备树节点标注而非 phy 编号"

# ── 无线满速口径（scripts/wifi-fullspeed.sh 落地，状态页显示）─────
WIFI_TARGET="fullspeed"
WIFI_NSS_FW="12.5"                # 12.5 优先；12.2 只在 12.5 起不来时回退
WIFI_OFFLOAD_PATH="ecm-nss"       # 本平台唯一真实加速路径：ECM→NSS，SFE 不干活
WIFI_NSS_OFFLOAD="1"              # 仅当基线确有 nss.general.wifi_offload 配置项时才拉回 1
WIFI_5G_BAND="HE160"              # CN 下唯一连续 160MHz（5170–5330，中心 5250）
WIFI_5G_CHANNEL="36"             # 36 起；HE160 覆盖 DFS，开机需约 60s CAC
WIFI_DFS_CAC="60s"               # CN + HE160 固有代价：期间 5G 不可见，2.4G 先起
WIFI_COUNTRY="CN"                # 世界域下 5G 被切成两段，radio1 会悄悄退回 80MHz
WIFI_2G_NOSCAN="0"               # 默认不开：HE40 会因共存扫描退 20MHz；强开 +50% 但无视邻区
WIFI_MEM_PROFILE="256M_LOW"      # 256MB 板必须，否则 ath11k probe 失败
WIFI_BDF="local"                 # 本机原厂 BDF 落盘，不联网下载（避开 403）
WIFI_SPEED_SOURCE="eth0/eth1"    # 不取 br-lan：被卸载的流量根本不经过 Linux 网桥

# 25.12.6 官方组件版本（抓取值，供 FIRMWARE.md / Release 说明引用）
OFFICIAL_25_12_6_KERNEL="6.12.112"
OFFICIAL_25_12_6_MAC80211_BACKPORTS="6.18.55"
OFFICIAL_25_12_6_OPENSSL="3.5.9"
OFFICIAL_25_12_6_MBEDTLS="3.6.7"
OFFICIAL_25_12_6_WOLFSSL="5.9.4"
OFFICIAL_25_12_6_REGDB="2026.09.03"
