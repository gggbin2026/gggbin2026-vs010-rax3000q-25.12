# OpenWrt 25.12 feeds（apk 时代）
# prepare.sh 的策略：不覆盖源码树自带的 feeds.conf.default，只把本文件里
# 「树里还没有」的源追加进去 —— 这样 qosmio 25.12-nss 自带的 NSS packages feed
# 不会被冲掉。基线 B（官方 v25.12.6）则直接用这份。

src-git-full packages https://github.com/openwrt/packages.git;openwrt-25.12
src-git-full luci https://github.com/openwrt/luci.git;openwrt-25.12
src-git-full routing https://github.com/openwrt/routing.git;openwrt-25.12
src-git-full telephony https://github.com/openwrt/telephony.git;openwrt-25.12
src-git-full video https://github.com/openwrt/video.git;openwrt-25.12

# ── 可选第三方源（按需取消注释；apk 包名要逐个核对）──
# src-git-full argon https://github.com/jerrykuku/luci-theme-argon.git;master
# src-git-full smartdns https://github.com/pymumu/openwrt-smartdns.git;master
# src-git-full luci-smartdns https://github.com/pymumu/luci-app-smartdns.git;master
# src-git-full smallpackage https://github.com/kenzok8/small-package.git;main
